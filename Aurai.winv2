TabCol:CreateColorPicker({name="Weather",flag="ColWeather",color=hex(Flags.ColWeather),callback=function(c) Flags.ColWeather=toHex(c); if WeatherParticle then WeatherParticle.Color=ColorSequence.new(c) end end})
