ConTab=Window:CreateTab({name="Console",icon=93364949241311})
flushConsole()
ConTab:CreateSection({name="Status"})
ConTab:CreateLabel({text=(HAS_DRAWING and "[OK]" or "[ERR]").." Drawing: "..(HAS_DRAWING and "READY" or "MISSING")})
ConTab:CreateLabel({text=(HAS_MOUSEMOVE and "[OK]" or "[N/A]").." mousemoverel"})
ConTab:CreateLabel({text=(HAS_HOOKMETHOD and "[OK]" or "[N/A]").." hookmetamethod"})
ConTab:CreateLabel({text=(HAS_SETHIDDEN and "[OK]" or "[N/A]").." sethiddenproperty"})
ConTab:CreateLabel({text=(HAS_SETFFLAG and "[OK]" or "[N/A]").." setfflag"})
ConTab:CreateLabel({text=(HAS_FIRECLICKDET and "[OK]" or "[N/A]").." fireclickdetector"})
ConTab:CreateLabel({text="Game: "..GRI.Name.." | Remote: "..GRI.Remote.." | Arg: "..GRI.Arg})
ConTab:CreateSection({name="Bugfixes Applied"})
ConTab:CreateLabel({text="[1] CRITICAL: DRAW_FONT pcall parse crash FIXED"})
ConTab:CreateLabel({text="[3] MEDIUM:   AutoReload remote lookup FIXED"})
ConTab:CreateLabel({text="[4] MEDIUM:   KnockStomp network ownership FIXED"})
ConTab:CreateLabel({text="[5] HIGH:     Bullet Tracers now fire on ShootGun FIXED"})
ConTab:CreateLabel({text="[6] HIGH:     CSync doCSSync() now called in loop FIXED"})
ConTab:CreateLabel({text="[7] LOW:      WingsPulse Rate modulation FIXED"})
ConTab:CreateLabel({text="[8] MEDIUM:   .Velocity -> .AssemblyLinearVelocity FIXED"})
ConTab:CreateLabel({text="[9] MEDIUM:   Aura system implemented FIXED"})
ConTab:CreateSection({name="Debug"})
ConTab:CreateButton({name="Dump All Players",callback=function()
    for _,p in ipairs(Players:GetPlayers()) do
        local char=p.Character; local hum=char and getHum(char)
        cInfo(p.Name.." | HP:"..(hum and math.floor(hum.Health) or "?").." | Enemy:"..(isEnemy(p) and "YES" or "NO").." | KO:"..(IS_DAHOOD and tostring(dh_isKnocked(p)) or "N/A"))
    end
    Window:Notify({title="Console",content="Dumped "..#Players:GetPlayers().." players",duration=2})
end})
ConTab:CreateButton({name="Ping Now",callback=function()
    updatePing()
    cOk("Ping: "..tostring(math.floor(currentPing)).."ms | PredVal: "..string.format("%.4f",Flags.PredVal))
    Window:Notify({title="Ping",content=tostring(math.floor(currentPing)).."ms",duration=2})
end})
ConTab:CreateButton({name="Force ESP Test Draw",callback=function()
    if not HAS_DRAWING then cFail("No Drawing API"); return end
    local ok,t=pcall(function()
        local t=Drawing.new("Text"); t.Text="AURAI v9 FIXED OK"; t.Position=Vector2.new(50,50)
        t.Color=Color3.fromRGB(0,255,80); t.Size=20; t.Font=DRAW_FONT; t.Visible=true
        task.delay(3,function() t:Remove() end); return t
    end)
    if ok then cOk("Test draw OK — 3s") else cFail("Draw fail: "..tostring(t)) end
end})
ConTab:CreateButton({name="Reload Glow & HL",callback=function()
    for p in pairs(glowStore) do clearGlow(p) end
    for p in pairs(hlStore) do pcall(function() hlStore[p]:Destroy() end); hlStore[p]=nil; getOrMakeHL(p) end
    cOk("Glow+HL reloaded")
end})

Window:Navigate(TabAim)
task.delay(0.5,function()
    LoadT=math.floor((tick()-LoadT)*1000)
    Window:Notify({
        title="aurai.win v9.0 [BUGFIXED]",
        content=string.format("Loaded %dms | %s | 8 bugs patched | [%s] aim",LoadT,GRI.Name,Flags.AimKey),
        duration=8,
    })
end)
cOk("v9.0 BUGFIXED boot complete — "..#Players:GetPlayers().." players")
print("[Aurai] v9.0 BUGFIXED — it freedom time fr fr")
