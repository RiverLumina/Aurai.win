-- [32] ASTRAL HIT EFFECTS SYSTEM
-- ═══════════════════════════════════════════════════════════
local HitEffectTypes={}
do
    local Part=Instance.new("Part"); Part.Parent=ReplicatedStorage
    local Att=Instance.new("Attachment"); Att.Name="HitEffectAtt"; Att.Parent=Part
    HitEffectTypes["Nova"]=Att
    local function mkE(acc)
        local e=Instance.new("ParticleEmitter"); e.Acceleration=acc
        e.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.new(0,0,0)),ColorSequenceKeypoint.new(0.495,Color3.fromRGB(255,100,100)),ColorSequenceKeypoint.new(1,Color3.new(0,0,0))})
        e.Lifetime=NumberRange.new(0.5,0.5); e.LightEmission=1; e.LockedToPart=true; e.Rate=1
        e.Rotation=NumberRange.new(0,360); e.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,10),NumberSequenceKeypoint.new(1,1)})
        e.Speed=NumberRange.new(0,0); e.Texture="rbxassetid://1084991215"; e.ZOffset=1; e.Parent=Att; return e
    end
    mkE(Vector3.new(0,0,1)); local e2=mkE(Vector3.new(0,1,-0.001)); e2.Orientation=Enum.ParticleOrientation.VelocityPerpendicular
    Part.Parent=workspace
end
do
    local Part=Instance.new("Part"); Part.Parent=ReplicatedStorage
    local Att=Instance.new("Attachment"); Att.Parent=Part; HitEffectTypes["Slash"]=Att
    local e=Instance.new("ParticleEmitter"); e.Name="Crescents"
    e.Lifetime=NumberRange.new(0.19,0.38); e.SpreadAngle=Vector2.new(-360,360)
    e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.19,0),NumberSequenceKeypoint.new(0.78,0),NumberSequenceKeypoint.new(1,1)})
    e.LightEmission=10; e.Color=ColorSequence.new(Color3.fromRGB(160,96,255))
    e.Speed=NumberRange.new(0.08,0.08); e.Brightness=4
    e.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(0.4,8.8),NumberSequenceKeypoint.new(1,11.5)})
    e.Enabled=false; e.Rate=50; e.Texture="rbxassetid://12509373457"
    e.RotSpeed=NumberRange.new(800,1000); e.Rotation=NumberRange.new(-360,360)
    e.Orientation=Enum.ParticleOrientation.VelocityPerpendicular; e.Parent=Att
    Part.Parent=workspace
end
do
    local Part=Instance.new("Part"); Part.Parent=ReplicatedStorage
    local Att=Instance.new("Attachment"); Att.Parent=Part; HitEffectTypes["Coom"]=Att
    local e=Instance.new("ParticleEmitter"); e.Name="Foam"
    e.LightInfluence=0.5; e.Lifetime=NumberRange.new(1,1); e.SpreadAngle=Vector2.new(360,-360)
    e.Speed=NumberRange.new(20,20); e.Brightness=2.5; e.Enabled=false
    e.Acceleration=Vector3.new(0,-66,0); e.Rate=100; e.Texture="rbxassetid://8297030850"
    e.Rotation=NumberRange.new(-90,-90); e.Orientation=Enum.ParticleOrientation.VelocityParallel; e.Parent=Att
    Part.Parent=workspace
end
do
    local Part=Instance.new("Part"); Part.Parent=ReplicatedStorage
    local Att=Instance.new("Attachment"); Att.Parent=Part; HitEffectTypes["Crescent"]=Att
    local glow=Instance.new("ParticleEmitter"); glow.Name="Glow"; glow.Lifetime=NumberRange.new(0.16,0.16)
    glow.Color=ColorSequence.new(Color3.fromRGB(91,177,252)); glow.Speed=NumberRange.new(0,0); glow.Brightness=5
    glow.Size=NumberSequence.new(9.19,16.5); glow.Enabled=false; glow.Rate=50; glow.Texture="rbxassetid://8708637750"; glow.Parent=Att
    Part.Parent=workspace
end
HitEffectTypes["Cosmic"]=HitEffectTypes["Nova"]
HitEffectTypes["Atomic"]=HitEffectTypes["Slash"]

local HitSounds={
    RIFK7="rbxassetid://9102080552",Bubble="rbxassetid://9102092728",Minecraft="rbxassetid://5869422451",
    Cod="rbxassetid://160432334",Bameware="rbxassetid://6565367558",Neverlose="rbxassetid://6565370984",
    Gamesense="rbxassetid://4817809188",Rust="rbxassetid://6565371338"
}
local function playHitSound()
    local id=HitSounds[Flags.HitSoundName]; if not id then return end
    local s=Instance.new("Sound"); s.SoundId=id; s.Volume=0.5; s.Parent=SoundService; s:Play()
    s.Ended:Connect(function() pcall(function() s:Destroy() end) end)
end
local function spawnHitEffect(char)
    if not Flags.HitEffects or not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local att=HitEffectTypes[Flags.HitEffectType] or HitEffectTypes["Nova"]; if not att then return end
    local clone=att:Clone(); clone.Parent=hrp
    for _,e in pairs(clone:GetChildren()) do
        if e:IsA("ParticleEmitter") then e:Emit() end
    end
    task.delay(2,function() pcall(function() clone:Destroy() end) end)
end
local targetHealth=nil
RunService.Stepped:Connect(function()
    local targ=(clActive and clTarget and Players:GetPlayerFromCharacter(clTarget.Parent))
              or (Target and Players:GetPlayerFromCharacter(Target))
    if not targ or not targ.Character then targetHealth=nil; return end
    local hum2=getHum(targ.Character); if not hum2 then targetHealth=nil; return end
    local curr=hum2.Health
    if targetHealth and curr<targetHealth then
        local dmg=targetHealth-curr
        if dmg>0.5 then
            if Flags.HitSound then playHitSound() end
            if Flags.HitEffects then spawnHitEffect(targ.Character) end
            if Flags.HitNotify then cOk("HIT "..targ.Name.." for "..string.format("%.1f",dmg)) end
        end
    end
    targetHealth=curr
end)

-- ═══════════════════════════════════════════════════════════
-- [33] ASTRAL WORLD VISUALS
-- ═══════════════════════════════════════════════════════════
local origLighting={FogEnd=Lighting.FogEnd,Ambient=Lighting.Ambient,Brightness=Lighting.Brightness,ClockTime=Lighting.ClockTime}
local function applyWorldVisuals()
    if not Flags.WorldEnable then
        for k,v in pairs(origLighting) do Lighting[k]=v end; return
    end
    if Flags.WorldFog then Lighting.FogEnd=Flags.WorldFogEnd end
    if Flags.WorldAmbient then Lighting.Ambient=Color3.new(1,1,1); Lighting.OutdoorAmbient=Color3.new(1,1,1) end
    if Flags.WorldBrightness then Lighting.Brightness=Flags.WorldBrightnessVal end
    if Flags.WorldClockTime then Lighting.ClockTime=Flags.WorldClockVal end
end
local function applyFullBright(on)
    if on then
        origLighting.Ambient=Lighting.Ambient; origLighting.OA=Lighting.OutdoorAmbient
        Lighting.Ambient=Color3.new(1,1,1); Lighting.OutdoorAmbient=Color3.new(1,1,1); Lighting.Brightness=2
    else
        if origLighting.Ambient then Lighting.Ambient=origLighting.Ambient end
        if origLighting.OA then Lighting.OutdoorAmbient=origLighting.OA end; Lighting.Brightness=1
    end
end
local function applyNoFog(on)
    if on then origLighting.FogEnd2=Lighting.FogEnd; Lighting.FogEnd=100000
    else if origLighting.FogEnd2 then Lighting.FogEnd=origLighting.FogEnd2 end end
end

-- ═══════════════════════════════════════════════════════════
-- [34] ASTRAL CROSSHAIR
-- ═══════════════════════════════════════════════════════════
local crosshairAngle=0; local crosshairLen=10; local crosshairGrowDir=1
local crosshairLines={}
local function updateCrosshair()
    for _,l in pairs(crosshairLines) do pcall(function() l:Remove() end) end; crosshairLines={}
    if not Flags.CrosshairEnable or not HAS_DRAWING then return end
    local cx,cy
    if Flags.CrosshairSticky then
        local ml=UserInputService:GetMouseLocation(); cx=ml.X; cy=ml.Y
    else cx=Camera.ViewportSize.X/2; cy=Camera.ViewportSize.Y/2 end
    local n=math.max(1,Flags.CrosshairLines); local angleStep=360/n
    local col=fc("ColCrosshair"); local len=crosshairLen; local r=Flags.CrosshairRadius
    for i=0,n-1 do
        local ang=math.rad(crosshairAngle+angleStep*i)
        local sx=cx+math.cos(ang)*r; local sy=cy+math.sin(ang)*r
        local ex=cx+math.cos(ang)*(r+len); local ey=cy+math.sin(ang)*(r+len)
        local l=mkLine(sx,sy,ex,ey,col,Flags.CrosshairWidth)
        if l then table.insert(crosshairLines,l) end
    end
end

-- ═══════════════════════════════════════════════════════════
-- [35] ASTRAL WINGS SYSTEM
-- ═══════════════════════════════════════════════════════════
local WingAttachments={}; local WingEmitters={}
local function clearWings(char)
    for _,a in ipairs(WingAttachments[char] or {}) do pcall(function() a:Destroy() end) end
    for _,e in ipairs(WingEmitters[char] or {}) do pcall(function() e:Destroy() end) end
    WingAttachments[char]=nil; WingEmitters[char]=nil
end
local function applyWings(char)
    if not (char and char:FindFirstChild("HumanoidRootPart")) then return end
    if WingAttachments[char] then return end
    local hrp=char.HumanoidRootPart
    local atts={}; local emits={}
    local offsets={CFrame.new(2,0.5,1)*CFrame.fromEulerAnglesXYZ(0,0.26,0),CFrame.new(-2,0.5,1)*CFrame.fromEulerAnglesXYZ(0,-0.26,0)}
    local dirs={Enum.NormalId.Front,Enum.NormalId.Back}
    for i,cf in ipairs(offsets) do
        local att=Instance.new("Attachment"); att.CFrame=cf; att.Parent=hrp; table.insert(atts,att)
        local e=Instance.new("ParticleEmitter"); e.Brightness=2; e.Color=ColorSequence.new(fc("ColWings"))
        e.LightEmission=1; e.LightInfluence=0; e.Orientation=Enum.ParticleOrientation.VelocityPerpendicular
        e.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,2.75),NumberSequenceKeypoint.new(1,3.5)})
        e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.94),NumberSequenceKeypoint.new(0.5,0.2),NumberSequenceKeypoint.new(0.8,0.8),NumberSequenceKeypoint.new(1,1)})
        e.LockedToPart=true; e.EmissionDirection=dirs[i]; e.Lifetime=NumberRange.new(1,1)
        e.Rate=4; e.Rotation=NumberRange.new(-15,-15); e.Speed=NumberRange.new(0.05,0.05); e.Parent=att
        table.insert(emits,e)
    end
    WingAttachments[char]=atts; WingEmitters[char]=emits
end

