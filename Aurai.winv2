    {0,0.1332},{40,0.12766},{50,0.128643},{60,0.12642},{70,0.12533},
    {80,0.13210},{90,0.14219},{100,0.13414},{110,0.14219},{125,0.15465},
    {135,0.16599},{150,0.16521},{170,0.16863},{190,0.18659},{225,0.17633},
}
local PingTable = {
    {40,0.1256},{50,0.1225},{60,0.1229},{70,0.131},{80,0.134},
    {90,0.136},{105,0.138},{110,0.146},{125,0.149},{130,0.151},
    {150,0.155},{175,0.165},{200,0.175},{999,0.185},
}
local currentPing = 0
local function updatePing()
    pcall(function()
        local raw=Stats.Network.ServerStatsItem["Data Ping"]:GetValueString()
        local parts=string.split(raw,"("); local p=tonumber(parts[1]); if not p then return end
        currentPing=p
        if Flags.PredAutoPing then
            local tbl = Flags.PredAutoMode=="BlatantTable" and BlatantTable
                     or Flags.PredAutoMode=="PingBased" and PingTable
                     or PredTable
            for _,row in ipairs(tbl) do
                if p<row[1] then Flags.PredVal=row[2]; break end
            end
        end
    end)
end
task.spawn(function() while task.wait(2) do updatePing() end end)

-- ═══════════════════════════════════════════════════════════
-- [13] RESOLVER
-- ═══════════════════════════════════════════════════════════
local ResolverData = {}
local function resolverGet(p,method,updateInterval)
    local char=p.Character; if not char then return Vector3.zero end
    local hrp=getRoot(char); if not hrp then return Vector3.zero end
    local uid=p.UserId
    if not ResolverData[uid] then
        ResolverData[uid]={positions={},timestamps={},velocities={},accelerations={},
            lastvelocity=Vector3.zero,lastacceleration=Vector3.zero,
            smoothedvelocity=Vector3.zero,lastupdate=0}
    end
    local d=ResolverData[uid]; local now=tick()
    if now-d.lastupdate<(updateInterval or 0.05) then return d.smoothedvelocity end
    d.lastupdate=now
    table.insert(d.positions,hrp.Position); table.insert(d.timestamps,now)
    local samples=Flags.ResolverSamples or 5
    while samples<#d.positions do table.remove(d.positions,1); table.remove(d.timestamps,1) end
    if #d.positions>=2 then
        local dt=d.timestamps[#d.timestamps]-d.timestamps[#d.timestamps-1]
        if dt>0 then
            local vel=(d.positions[#d.positions]-d.positions[#d.positions-1])/dt
            table.insert(d.velocities,vel)
            while samples<#d.velocities do table.remove(d.velocities,1) end
            if d.lastvelocity then
                local acc=(vel-d.lastvelocity)/dt; table.insert(d.accelerations,acc)
                while samples<#d.accelerations do table.remove(d.accelerations,1) end
                d.lastacceleration=acc
            end
            d.lastvelocity=vel
        end
    end
    local v33; local smooth=Flags.ResolverSmooth or 0.5
    if method=="Interpolation" then
        if #d.velocities>=2 then
            local sum,wsum=Vector3.zero,0
            for i=1,#d.velocities do local w=i/#d.velocities; sum=sum+d.velocities[i]*w; wsum=wsum+w end
            v33=wsum>0 and sum/wsum or d.lastvelocity
        else v33=d.lastvelocity end
    elseif method=="Extrapolation" then
        if #d.velocities>=2 then
            v33=d.velocities[#d.velocities]+d.lastacceleration*0.1
        else v33=d.lastvelocity end
    else
        if #d.velocities>=2 then
            local sum,wsum=Vector3.zero,0
            for i=1,#d.velocities do local w=i/#d.velocities; sum=sum+d.velocities[i]*w; wsum=wsum+w end
            local interp=wsum>0 and sum/wsum or d.lastvelocity
            local extrap=d.velocities[#d.velocities]+d.lastacceleration*0.1
            v33=interp:Lerp(extrap,smooth)
        else v33=d.lastvelocity end
    end
    if v33.Magnitude>100 then v33=v33.Unit*100 end
    d.smoothedvelocity=d.smoothedvelocity:Lerp(v33,1-smooth)
    return d.smoothedvelocity
end

-- ═══════════════════════════════════════════════════════════
-- [14] PREDICTION
-- ═══════════════════════════════════════════════════════════
local function getPredictedPosition(p,part)
    if not Flags.PredEnable then return part.Position end
    local vel = Flags.ResolverEnable and resolverGet(p,Flags.ResolverMethod,0.05)
                                      or part.AssemblyLinearVelocity
    if not Flags.PredVertical then vel=Vector3.new(vel.X,0,vel.Z) end
    local lead=vel*Flags.PredVal
    if lead.Magnitude>(Flags.PredMaxLead or 15) then lead=lead.Unit*Flags.PredMaxLead end
    if isInAir(p) and vel.Y<0 then lead=Vector3.new(lead.X,0,lead.Z) end
    return part.Position+lead
end
local function getPredPosHV(part,vel,hpred,vpred,jumpOffset)
    if not part then return Vector3.zero end
    local base=part.Position
    if vel and (vel.X~=0 or vel.Y~=0 or vel.Z~=0) then
        return Vector3.new(base.X+(vel.X*hpred),base.Y+(vel.Y*vpred)+(jumpOffset or 0),base.Z+(vel.Z*hpred))
    end
    return Vector3.new(base.X,base.Y+(jumpOffset or 0),base.Z)
end

-- ═══════════════════════════════════════════════════════════
-- [15] TARGET VALIDATION
-- ═══════════════════════════════════════════════════════════
local function isReady(char)
    if not char then return false end
    local p=Players:GetPlayerFromCharacter(char)
    if not p or p==LP then return false end
    local hum=getHum(char); if not hum then return false end
    local aimPart=getAimPart(char); if not aimPart then return false end
    local myChar=LP.Character; if not myChar then return false end
    local myRoot=getRoot(myChar); if not myRoot then return false end
    if Flags.AimAliveCheck and hum.Health<=0 then return false end
    if hum.Health>=10^36 or myChar:FindFirstChildOfClass("ForceField") then return false end
    if Flags.AimTeamCheck then
        local ok,same=pcall(function() return p.TeamColor==LP.TeamColor end)
        if ok and same then return false end
    end
    if Flags.AimWallCheck then
        local dir=aimPart.Position-myRoot.Position
        local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances={myChar}
        local result=workspace:Raycast(myRoot.Position,dir,rp)
        if not result or not result.Instance then return false end
        if not result.Instance:FindFirstAncestor(p.Name) then return false end
    end
    local vpPos,inV=Camera:WorldToViewportPoint(aimPart.Position)
    if not inV then return false end
    if Flags.AimFOVCheck then
        local mousePos=UserInputService:GetMouseLocation()
        local dx=vpPos.X-mousePos.X; local dy=vpPos.Y-mousePos.Y
        if math.sqrt(dx*dx+dy*dy)>Flags.AimFOV then return false end
    end
    local predicted=getPredictedPosition(p,aimPart)
    local predVP=Camera:WorldToViewportPoint(predicted)
    return true,char,Vector2.new(vpPos.X,vpPos.Y),predicted,aimPart,Vector2.new(predVP.X,predVP.Y)
end

-- ═══════════════════════════════════════════════════════════
-- [16] CAMLOCK — ethereal elastic+sine smoothing
-- ═══════════════════════════════════════════════════════════
local clActive,clTarget,clLastVisible=false,nil,nil
local function elasticOut(t) local p=0.3; return math.pow(2,-10*t)*math.sin((t-p/4)*(2*math.pi)/p)+1 end
local function sineInOut(t) return -(math.cos(math.pi*t)-1)/2 end
local function findCLTarget()
    local best,bd=nil,math.huge; local mp=UserInputService:GetMouseLocation()
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        local char=p.Character; if not char then continue end
        if Flags.CamLockTeam and p.Team==LP.Team then continue end
        if Flags.CamLockKnock and dh_isKnocked(p) then continue end
        if Flags.CamLockDead and dh_isDead(p) then continue end
        local part=getAimPart(char,Flags.CamLockPart); if not part then continue end
        local sp,on=Camera:WorldToViewportPoint(part.Position); if not on then continue end
        local d=(Vector2.new(sp.X,sp.Y)-mp).Magnitude
        if d>=bd then continue end
        if Flags.CamLockWall and not canSee(part) then continue end
        bd=d; best=part
    end
    return best
end
local function doCamLock()
    if not Flags.CamLockEnable or not clActive then return end
    if not clTarget or not clTarget.Parent then
        clActive=false; clTarget=nil; clLastVisible=nil; return
    end
    local p=Players:GetPlayerFromCharacter(clTarget.Parent)
    if not p or (Flags.CamLockDead and dh_isDead(p)) or (Flags.CamLockKnock and dh_isKnocked(p)) then
        clActive=false; clTarget=nil; clLastVisible=nil; return
    end
    local fresh=getAimPart(clTarget.Parent,Flags.CamLockPart)
    if fresh and fresh.Parent then clTarget=fresh end
    if Flags.CamLockWall and not canSee(clTarget) then
        if clLastVisible and clLastVisible.Parent then clTarget=clLastVisible end; return
    end
    clLastVisible=clTarget
    local vel=clTarget.AssemblyLinearVelocity
    local tPos=clTarget.Position+Vector3.new(vel.X*Flags.PredVal,vel.Y*Flags.PredVal,0)
    local cur=Camera.CFrame; local tgt=CFrame.new(cur.Position,tPos)
    local aX=math.clamp(Flags.CamLockSmX,0.001,1); local aY=math.clamp(Flags.CamLockSmY,0.001,1)
    local avg=(aX+aY)*0.5
    local eaX=elasticOut(aX); local eaY=elasticOut(aY)
    local cL=cur.LookVector; local tL=tgt.LookVector
    local dir=Vector3.new(cL.X+(tL.X-cL.X)*(eaX*aX),cL.Y+(tL.Y-cL.Y)*(eaY*aY),cL.Z+(tL.Z-cL.Z)*(eaX*aX))
    if dir.Magnitude<=0 then return end
    local smoothCF=CFrame.new(cur.Position,cur.Position+dir.Unit)
    Camera.CFrame=smoothCF:Lerp(tgt,sineInOut(math.min(avg,1))*avg)
end

-- ═══════════════════════════════════════════════════════════
-- [17] AIMBOT STATE
-- ═══════════════════════════════════════════════════════════
local Aiming=false; local Target=nil; local AimTween=nil
local SavedMouseSens=UserInputService.MouseDeltaSensitivity
local function resetAimbot(keepTarget)
    Aiming=not keepTarget and false or Aiming
    if not keepTarget then Target=nil end
    if AimTween then AimTween:Cancel(); AimTween=nil end
    UserInputService.MouseDeltaSensitivity=SavedMouseSens
end
local AimKeyEnum=Enum.KeyCode.E
local function strToKeyEnum(s)
    if s=="RMB" then return Enum.UserInputType.MouseButton2 end
    if s=="LMB" then return Enum.UserInputType.MouseButton1 end
    local ok,v=pcall(function() return Enum.KeyCode[s] end); return ok and v or Enum.KeyCode.E
end
AimKeyEnum=strToKeyEnum(Flags.AimKey)
UserInputService.InputBegan:Connect(function(input,gpe)
    if gpe or UserInputService:GetFocusedTextBox() then return end
    local matchKey=(input.KeyCode==AimKeyEnum or input.UserInputType==AimKeyEnum)
    if matchKey and Flags.AimEnable then
        if Flags.AimOnePressMode then if Aiming then resetAimbot() else Aiming=true end else Aiming=true end
    end
    if input.KeyCode==Enum.KeyCode.C and Flags.CamLockEnable and not gpe then
        if clActive then clActive=false; clTarget=nil; clLastVisible=nil
        else clTarget=findCLTarget(); if clTarget then clActive=true end end
    end
end)
UserInputService.InputEnded:Connect(function(input,gpe)
    if gpe then return end
    local matchKey=(input.KeyCode==AimKeyEnum or input.UserInputType==AimKeyEnum)
    if matchKey and not Flags.AimOnePressMode then resetAimbot() end
end)

-- ═══════════════════════════════════════════════════════════
-- [18] SILENT AIM HOOK + FINOBE CFRAME SPOOF
-- ═══════════════════════════════════════════════════════════
local _finobeReal = nil
-- ╔══════════════════════════════════════════════════════════╗
-- ║ BUG #5 FIX — Bullet Tracers                             ║
-- ║ CreateTracerBeam was defined but NEVER called.          ║
-- ║ Fix: intercept ShootGun in __namecall hook below        ║
-- ╚══════════════════════════════════════════════════════════╝
local function CreateTracerBeam(startPos,endPos,color1,color2,duration,fadeEnabled)
    local mp=Instance.new("Part"); mp.Parent=workspace; mp.Size=Vector3.zero; mp.Transparency=1; mp.CanCollide=false; mp.Anchored=true; mp.Position=startPos
    local p0=Instance.new("Part"); p0.Parent=mp; p0.Size=Vector3.zero; p0.Transparency=1; p0.CanCollide=false; p0.Anchored=true; p0.Position=startPos
    local p1=Instance.new("Part"); p1.Parent=mp; p1.Size=Vector3.zero; p1.Transparency=1; p1.CanCollide=false; p1.Anchored=true; p1.Position=endPos
    local a0=Instance.new("Attachment"); a0.Parent=p0
    local a1=Instance.new("Attachment"); a1.Parent=p1
    local beam=Instance.new("Beam"); beam.Parent=mp; beam.Texture="rbxassetid://446111271"
    beam.TextureMode=Enum.TextureMode.Wrap; beam.TextureLength=10; beam.LightEmission=1; beam.FaceCamera=true
    beam.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,color1),ColorSequenceKeypoint.new(1,color2)})
    beam.Attachment0=a0; beam.Attachment1=a1; beam.Width0=Flags.BulletWidth; beam.Width1=Flags.BulletWidth; beam.Enabled=true
    if fadeEnabled then
        local total=0
        RunService.Heartbeat:Connect(function(dt)
            total=total+dt; local prog=math.min(total/Flags.BulletDuration,1)
            beam.Transparency=NumberSequence.new(prog)
        end)
    end
    task.delay(Flags.BulletDuration,function() pcall(function() mp:Destroy() end) end)
end

if HAS_HOOKMETHOD then
    local oldIndex; oldIndex=hookmetamethod(game,"__index",newcclosure(function(self,idx)
        if not checkcaller() then
            if Flags.AimEnable and Flags.AimMode=="Silent" and Aiming then
                local ok,_,vpPos,worldPos,aimPart=isReady(Target)
                if ok and self==Mouse and math.random(1,100)<=Flags.SilentChance then
                    if     idx=="Hit" or idx=="hit"       then return CFrame.new(worldPos)
                    elseif idx=="Target" or idx=="target" then return aimPart
                    elseif idx=="X" or idx=="x"           then return vpPos.X
                    elseif idx=="Y" or idx=="y"           then return vpPos.Y end
                end
            end
            if _finobeReal and idx=="CFrame" and LP.Character then
                local lHRP=LP.Character:FindFirstChild("HumanoidRootPart")
                local hum=LP.Character:FindFirstChildOfClass("Humanoid")
                if lHRP and hum and hum.Health>0 and self==lHRP then return _finobeReal end
            end
        end
        return oldIndex(self,idx)
    end))
    local oldNameCall; oldNameCall=hookmetamethod(game,"__namecall",newcclosure(function(...)
        local method=getnamecallmethod(); local args={...}; local self=args[1]
        if not checkcaller() then
            -- Silent aim intercept
            if Flags.AimEnable and Flags.AimMode=="Silent" and Aiming and math.random(1,100)<=Flags.SilentChance then
                local ok,_,vpPos,worldPos=isReady(Target)
                if ok then
                    if self==UserInputService and method=="GetMouseLocation" then
                        return Vector2.new(vpPos.X,vpPos.Y)
                    elseif self==workspace and (method=="Raycast" or method=="raycast")
                        and typeof(args[2])=="Vector3" and typeof(args[3])=="Vector3" then
                        if (args[2]-Camera.CFrame.Position).Magnitude<8 then
                            args[3]=(worldPos-args[2]); return oldNameCall(table.unpack(args))
                        end
                    end
                end
            end
            -- BUG #5 FIX: intercept ShootGun FireServer to spawn bullet tracer
            if Flags.BulletTracers and method=="FireServer" then
                local evName = pcall(function() return self.Name end) and self.Name or ""
                if evName=="MainEvent" or evName=="MAINEVENT" then
                    local shootArg = args[2]
                    if shootArg=="ShootGun" or shootArg=="Shoot" then
                        local myChar=LP.Character; local myHRP=myChar and getRoot(myChar)
                        local endPos = typeof(args[5])=="Vector3" and args[5]
                                    or typeof(args[4])=="Vector3" and args[4]
                                    or nil
                        if myHRP and endPos then
                            pcall(function()
                                CreateTracerBeam(
                                    myHRP.Position,
                                    endPos,
                                    fc("ColBulletStart"),
                                    fc("ColBulletEnd"),
                                    Flags.BulletDuration,
                                    Flags.BulletFade
                                )
                            end)
                        end
                    end
                end
            end
        end
        return oldNameCall(...)
    end))
    cOk("Silent aim hooks + tracer hook installed")
end

-- ═══════════════════════════════════════════════════════════
-- [19] DAHOOD FORCE HIT
-- ═══════════════════════════════════════════════════════════
local DH_ffTimings={}
local function dh_shouldTarget(p)
    if not p or not p.Character then return false end
    if Flags.DH_FHKOCheck and dh_isKnocked(p) then return false end
    if dh_isDead(p) then return false end
    if Flags.DH_FFCheck and not Flags.DH_PrefireFF then
        if p.Character:FindFirstChildOfClass("ForceField") then return false end
    end
    return true
end
local function dh_fire_hoodcustoms(targetPlayer)
    if not (targetPlayer and targetPlayer.Character) then return end
    if not dh_shouldTarget(targetPlayer) then return end
    if not DH_Remote then return end
    local char=targetPlayer.Character
    local tp=char:FindFirstChild(Flags.DH_FHHitPart) or char:FindFirstChild("Head"); if not tp then return end
    local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart"); if not root then return end
    if Flags.AimWallCheck then
        local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances={LP.Character,char}
        local r=workspace:Raycast(Camera.CFrame.Position,tp.Position-Camera.CFrame.Position,rp)
        if r then return end
    end
    if (root.Position-tp.Position).Magnitude>Flags.DH_MaxDist then return end
    local pos=root.Position
    local args={[1]="Shoot",[2]={
        [1]={[1]={Normal=tp.Position,Instance=tp,Position=tp.Position},
             [2]={Normal=tp.Position,Instance=tp,Position=tp.Position},
             [3]={Normal=tp.Position,Instance=tp,Position=tp.Position},
             [4]={Normal=tp.Position,Instance=tp,Position=tp.Position},
             [5]={Normal=tp.Position,Instance=tp,Position=tp.Position}},
        [2]={[1]={thePart=tp,theOffset=Vector3.zero},[2]={thePart=tp,theOffset=Vector3.zero},
             [3]={thePart=tp,theOffset=Vector3.zero},[4]={thePart=tp,theOffset=Vector3.zero},
             [5]={thePart=tp,theOffset=Vector3.zero}},
        [3]=pos,[4]=pos,[5]=workspace:GetServerTimeNow()}}
    pcall(function() DH_Remote:FireServer(_unpack(args)) end)
end
local DH_fhTarget=nil
local function dh_fire_dahood(targetPlayer)
    if not (targetPlayer and targetPlayer.Character) then DH_fhTarget=nil; return end
    if not dh_shouldTarget(targetPlayer) then DH_fhTarget=nil; return end
    if not DH_Remote then return end
    local char=targetPlayer.Character
    local tp=char:FindFirstChild(Flags.DH_FHHitPart) or char:FindFirstChild("Head"); if not tp then DH_fhTarget=nil; return end
    local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart"); if not root then return end
    if (root.Position-tp.Position).Magnitude>Flags.DH_MaxDist then return end
    DH_fhTarget=targetPlayer
    pcall(function() DH_Remote:FireServer(GRI.Arg,tp.Position) end)
end
local function dh_fire(t)
    if not DH_Remote then return end
    if Flags.DH_FHMode=="Dahood" then dh_fire_dahood(t) else dh_fire_hoodcustoms(t) end
end
if IS_DAHOOD and DH_Remote then
    task.spawn(function()
        local function monitorFF(plr)
            if plr==LP then return end
            local function setupChar(char)
                if not char then return end; local lastFFTime=0
                char.ChildAdded:Connect(function(c) if c:IsA("ForceField") then lastFFTime=tick() end end)
                char.ChildRemoved:Connect(function(c)
                    if not c:IsA("ForceField") or not Flags.DH_FH then return end
                    local elapsed=tick()-lastFFTime
                    if Flags.DH_PrefireFF then
                        DH_ffTimings[plr.UserId]=DH_ffTimings[plr.UserId] or {}
                        table.insert(DH_ffTimings[plr.UserId],elapsed)
                        if #DH_ffTimings[plr.UserId]>5 then table.remove(DH_ffTimings[plr.UserId],1) end
                        local avg=0; for _,t in ipairs(DH_ffTimings[plr.UserId]) do avg=avg+t end
                        avg=avg/#DH_ffTimings[plr.UserId]
                        task.delay(math.clamp(avg*0.095,0.025,0.065),function()
                            if Flags.DH_FH then dh_fire(plr) end
                        end)
                    end
                end)
            end
            if plr.Character then setupChar(plr.Character) end
            plr.CharacterAdded:Connect(setupChar)
        end
        for _,plr in ipairs(Players:GetPlayers()) do monitorFF(plr) end
        Players.PlayerAdded:Connect(monitorFF)
    end)
    cOk("DaHood FF prefire monitor active")
end

-- ═══════════════════════════════════════════════════════════
-- [20] AVENIR KNOCK STOMP
-- ═══════════════════════════════════════════════════════════
local KnockStompActive=false
local function findNearbyKnocked()
    local char=LP.Character; if not (char and char:FindFirstChild("HumanoidRootPart")) then return nil end
    local pos=char.HumanoidRootPart.Position
    for _,p in pairs(Players:GetPlayers()) do
        if p==LP or not p.Character or dh_isDead(p) or not dh_isKnocked(p) then continue end
        local hrp=p.Character:FindFirstChild("HumanoidRootPart"); if not hrp then continue end
        local mag=(pos-hrp.Position).Magnitude
        if not Flags.KnockStompUseRange or mag<=Flags.KnockStompRange then return hrp,p end
    end
    return nil,nil
end
task.spawn(function()
    while true do
        task.wait(0.3)
        if not KnockStompActive then continue end
        local myChar=LP.Character; if not (myChar and myChar:FindFirstChild("HumanoidRootPart")) then continue end
        local myHRP=myChar.HumanoidRootPart
        local tHRP,tPlayer=findNearbyKnocked()
        if not (tHRP and tPlayer) then continue end
        local origCF=myHRP.CFrame
        while KnockStompActive and tPlayer and dh_isKnocked(tPlayer) and not dh_isDead(tPlayer) do
            if tHRP and tHRP.Parent then
                -- ╔══════════════════════════════════════════════════╗
                -- ║ BUG #4 FIX — KnockStomp network ownership       ║
                -- ║ Without owning the part server rubber-bands you  ║
                -- ╚══════════════════════════════════════════════════╝
                pcall(function()
                    if HAS_SETHIDDEN then sethiddenproperty(myHRP,"NetworkOwnership",LP) end
                end)
                myHRP.CFrame=CFrame.new(tHRP.Position)
                myHRP.AssemblyLinearVelocity=Vector3.zero  -- BUG#8 fix: was .Velocity
                myHRP.AssemblyAngularVelocity=Vector3.zero
            end
            pcall(function()
    if ReplicatedStorage:FindFirstChild("MainEvent") then
        ReplicatedStorage.MainEvent:FireServer("Stomp")
    end
end)
            pcall(function()
                local remote = ReplicatedStorage:FindFirstChild("MAINEVENT")
                if remote then
                    remote:FireServer("STOMP")
                end
            end)
            task.wait(0.05)
        end
        pcall(function()
            myHRP.CFrame=origCF
            myHRP.AssemblyLinearVelocity=Vector3.zero  -- BUG#8 fix
            myHRP.AssemblyAngularVelocity=Vector3.zero
        end)
    end
end)

-- ═══════════════════════════════════════════════════════════
-- [21] AVENIR AUTO RELOAD
-- ═══════════════════════════════════════════════════════════
-- ╔══════════════════════════════════════════════════════════╗
-- ║ BUG #3 FIX — AutoReload remote lookup                   ║
-- ║ OLD: FindFirstChild("rl") — brittle, no type check      ║
-- ║ FIX: FindFirstChildOfClass("RemoteEvent") with IsA guard║
-- ╚══════════════════════════════════════════════════════════╝
local function autoReloadCheck()
    if not Flags.AutoReload then return end
    local char=LP.Character; if not char then return end
    local tool=char:FindFirstChildOfClass("Tool"); if not (tool and tool:FindFirstChild("AMMO")) then return end
    local ammo=tool:FindFirstChild("AMMO")
    if ammo and ammo.Value<=0 then
        -- search for reload remote by class first, then fallback to name "rl"
        local rl = tool:FindFirstChildOfClass("RemoteEvent") or tool:FindFirstChild("rl")
        if rl and rl:IsA("RemoteEvent") then
            pcall(function() rl:FireServer() end)
        end
    end
end

-- ═══════════════════════════════════════════════════════════
-- [22] AVENIR AUTO BUY
-- ═══════════════════════════════════════════════════════════
local ShopCache={locations=nil,lastUpdate=0,updateInterval=30}
local ShopItemCache={}
local GunShopItems={"[Shotgun]","[Silencer]","[Tactical Shotgun]","[Double-Barrel SG]","[Revolver]","[SMG]",
    "[P90]","[AK47]","[AR]","[SilencerAR]","[LMG]","[Flamethrower]","[DrumGun]","[Aug]","[Drum]",
    "[USP]","[Glock]","[Knife]","[Bat]","[Katana]","[Machete]","[Medkit]","[Radio]","[Boombox]","[Flashlight]"}
local ArmorShopItems={"[High-Medium Armor]","[Medium Armor]","[High Armor]","[Light Armor]","[Armor]"}
local AutoBuySelected={}

local function getShopLocations()
    local now=tick()
    if ShopCache.locations and now-ShopCache.lastUpdate<ShopCache.updateInterval then return ShopCache.locations end
    local locs={}; local seen={}
    local names={"Pads","Shops","BuyPads","Shop","Buy","Store","Dealers","GunDealer","GunShop","Items","Purchase"}
    local MAP=workspace:FindFirstChild("MAP")
    for _,n in ipairs(names) do
        local f=MAP and MAP:FindFirstChild(n) or workspace:FindFirstChild(n)
        if f and not seen[f] then table.insert(locs,f); seen[f]=true end
    end
    ShopCache.locations=locs; ShopCache.lastUpdate=now; return locs
end
local function findShopItem(name)
    if ShopItemCache[name] then
        local c=ShopItemCache[name]
        if c.item and c.item.Parent and c.cd and c.cd.Parent then return c.item,c.cd end
        ShopItemCache[name]=nil
    end
    local locs=getShopLocations()
    local plain=name:gsub("%[",""):gsub("%]","")
    for _,loc in ipairs(locs) do
        for _,child in ipairs(loc:GetChildren()) do
            if child.Name==name or child.Name:find(plain,1,true) then
                local cd=child:FindFirstChildOfClass("ClickDetector")
                if cd then ShopItemCache[name]={item=child,cd=cd}; return child,cd end
            end
        end
    end
    return nil,nil
end
local function hasItem(name)
    local n=name:lower():gsub("%[",""):gsub("%]",""):gsub(" ","")
    local function check(c)
        return c:IsA("Tool") and c.Name:lower():gsub(" ",""):find(n,1,true)
    end
    for _,c in pairs(LP.Backpack:GetChildren()) do if check(c) then return true end end
    if LP.Character then for _,c in pairs(LP.Character:GetChildren()) do if check(c) then return true end end end
    return false
end
local function buyItem(name)
    if hasItem(name) then return true end
    local _,cd=findShopItem(name); if not cd then return false end
    for i=1,5 do
        if HAS_FIRECLICKDET then pcall(fireclickdetector,cd)
        else pcall(function() cd:FireHit(LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")) end) end
        task.wait(0.15)
        if hasItem(name) then return true end
    end
    return false
end
local function runAutoBuy()
    if not Flags.AutoBuy then return end
    task.spawn(function()
        task.wait(0.8)
        if dh_getArmor(LP)<Flags.AutoBuyArmor then
            for _,aName in ipairs(ArmorShopItems) do
                local _,cd=findShopItem(aName)
                if cd then
                    for _=1,3 do
                        if HAS_FIRECLICKDET then pcall(fireclickdetector,cd) else pcall(function() cd:FireHit(LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")) end) end
                        task.wait(0.15)
                    end; break
                end
            end
        end
        for name,enabled in pairs(AutoBuySelected) do
            if enabled then buyItem(name) end
            task.wait(0.1)
        end
    end)
end
LP.CharacterAdded:Connect(function() ShopItemCache={}; task.wait(0.5); runAutoBuy() end)

-- ═══════════════════════════════════════════════════════════
-- [23] AVENIR ANTI LOCK
-- ═══════════════════════════════════════════════════════════
local AimLockTarget=nil
local function doAntiLock()
    if not Flags.AntiLock then return end
    local char=LP.Character; if not (char and char:FindFirstChild("HumanoidRootPart")) then return end
    local hrp=char.HumanoidRootPart
    if Flags.AntiLockMode=="Jitter" then
        hrp.CFrame=CFrame.new(hrp.Position)*CFrame.Angles(0,math.rad(math.random(-180,180)),0)
    elseif Flags.AntiLockMode=="Reverse" then
        local t=AimLockTarget or (clActive and clTarget and Players:GetPlayerFromCharacter(clTarget.Parent))
        if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
            local tPos=t.Character.HumanoidRootPart.Position
            hrp.CFrame=CFrame.new(hrp.Position,Vector3.new(tPos.X,hrp.Position.Y,tPos.Z))*CFrame.Angles(0,math.rad(180),0)
        end
    elseif Flags.AntiLockMode=="Side" then
        local t=AimLockTarget or (clActive and clTarget and Players:GetPlayerFromCharacter(clTarget.Parent))
        if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
            local tPos=t.Character.HumanoidRootPart.Position
            hrp.CFrame=CFrame.new(hrp.Position,Vector3.new(tPos.X,hrp.Position.Y,tPos.Z))*CFrame.Angles(0,math.rad(90),0)
        end
    end
end

-- ═══════════════════════════════════════════════════════════
-- [24] AVENIR REMOVE SEATS
-- ═══════════════════════════════════════════════════════════
LP.CharacterAdded:Connect(function(char)
    local hum=char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    hum.Seated:Connect(function(isSeated)
        if isSeated and Flags.RemoveSeats then hum.Sit=false; hum.Jump=true end
    end)
end)

-- ═══════════════════════════════════════════════════════════
-- [25] AVENIR TARGET STRAFE
-- ═══════════════════════════════════════════════════════════
local strafeAngle=0; local strafeLastTick=tick()
local StrafeShapes={
    Normal=function(a,d,h) return Vector3.new(math.cos(a)*d,h,math.sin(a)*d) end,
    Elliptical=function(a,d,h) return Vector3.new(math.cos(a)*d,h+math.sin(a*2)*2,math.sin(a)*d*0.6) end,
    Heart=function(a,d,h) local k=d/16; return Vector3.new(16*math.pow(math.sin(a),3)*k,(13*math.cos(a)-5*math.cos(2*a)-2*math.cos(3*a)-math.cos(4*a))*k+h,0) end,
    Star=function(a,d,h) local r=d*(1+0.5*math.cos(5*a)); return Vector3.new(r*math.cos(a),h,r*math.sin(a)) end,
    Infinity=function(a,d,h) local k=d/2; local k2=1+math.pow(math.sin(a),2); return Vector3.new(k*math.cos(a)/k2*2,h,k*math.sin(a)*math.cos(a)/k2*2) end,
    Helix=function(a,d,h) return Vector3.new(d*math.cos(a),h+math.sin(a*2)*3,d*math.sin(a)) end,
    Rose=function(a,d,h) local r=d*math.cos(4*a); return Vector3.new(r*math.cos(a),h,r*math.sin(a)) end,
}
local function doTargetStrafe()
    if not Flags.StrafeEnable then return end
    local tPlayer=(clActive and clTarget and Players:GetPlayerFromCharacter(clTarget.Parent)) or Target and Players:GetPlayerFromCharacter(Target)
    if not (tPlayer and tPlayer.Character and tPlayer.Character:FindFirstChild("HumanoidRootPart")) then return end
    local myChar=LP.Character; if not (myChar and myChar:FindFirstChild("HumanoidRootPart")) then return end
    local myHRP=myChar.HumanoidRootPart; local tHRP=tPlayer.Character.HumanoidRootPart
    local now=tick(); local dt=now-strafeLastTick; strafeLastTick=now
    strafeAngle=strafeAngle+dt*Flags.StrafeSpeed
    local shapeFn=StrafeShapes[Flags.StrafePattern] or StrafeShapes.Normal
    local offset=shapeFn(strafeAngle,Flags.StrafeDistance,Flags.StrafeHeight)
    local newCF=CFrame.new(tHRP.Position+offset,tHRP.Position)
    myHRP.CFrame=newCF
    myHRP.AssemblyLinearVelocity=Vector3.zero  -- BUG#8 fix
    myHRP.AssemblyAngularVelocity=Vector3.zero
end

-- ═══════════════════════════════════════════════════════════
-- [26] ETHEREAL RESOLVER / SKY-DIVE STOMP
-- ═══════════════════════════════════════════════════════════
local EthResolver={
    Active=false,Target=nil,StompEnabled=true,Connections={},
    State={attached=false,stomping=false,skyDiveActive=false,voidFrozen=false,
           storedProps={},lastStabTime=0,lastStompSpam=0,positionSwitchTimer=0,
           currentOffsetDir=Vector3.new(0,0,-1),beam=nil,a0=nil,a1=nil,hue=0}
}
local ETH_CFG={SKY_TIME=0.1,GROUND_TIME=0.1,STAB_COOLDOWN=0.01,POSITION_SWITCH_INTERVAL=0.1,
    STOMP_HEIGHT=4,STOMP_SPAM_COUNT=12,STOMP_SPAM_INTERVAL=0.03,VOID_HEIGHT=50000,OFFSET_DISTANCE=3}
local function ethSetVoidMode(enable)
    local char=LP.Character; if not char then return end
    if enable then
        for _,part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name~="HumanoidRootPart" then
                EthResolver.State.storedProps[part]={CanCollide=part.CanCollide,Transparency=part.Transparency,Material=part.Material}
                part.CanCollide=false; part.Transparency=1; part.Material=Enum.Material.Air
            end
        end
        local hum=char:FindFirstChildOfClass("Humanoid")
        if hum then hum.MaxHealth=math.huge; hum.Health=hum.MaxHealth; hum.PlatformStand=true end
    else
        for part,props in pairs(EthResolver.State.storedProps) do
            if part and part.Parent then
                part.CanCollide=props.CanCollide; part.Transparency=props.Transparency; part.Material=props.Material
            end
        end
        EthResolver.State.storedProps={}
        local hum=char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.MaxHealth=100; hum.PlatformStand=false end
    end
end
local function ethRandomDir() local a=math.random()*6.283; return Vector3.new(math.cos(a),0,math.sin(a)) end
local function ethSkyDiveLoop()
    while EthResolver.Active and EthResolver.State.skyDiveActive do
        if EthResolver.State.stomping then EthResolver.State.skyDiveActive=false; break end
        if not (EthResolver.Target and EthResolver.Target.Character) then EthResolver.State.skyDiveActive=false; break end
        local char=LP.Character; if not char then break end
        local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then break end
        EthResolver.State.attached=false
        local voidCF=CFrame.new(hrp.Position.X,ETH_CFG.VOID_HEIGHT,hrp.Position.Z)
        hrp.CFrame=voidCF
        hrp.AssemblyLinearVelocity=Vector3.zero  -- BUG#8 fix
        hrp.AssemblyAngularVelocity=Vector3.zero
        ethSetVoidMode(true)
        local s=tick()
        while tick()-s<ETH_CFG.SKY_TIME and EthResolver.Active and EthResolver.State.skyDiveActive and not EthResolver.State.stomping do
            hrp.CFrame=voidCF
            hrp.AssemblyLinearVelocity=Vector3.zero  -- BUG#8 fix
            hrp.AssemblyAngularVelocity=Vector3.zero
            local hum=char:FindFirstChildOfClass("Humanoid"); if hum then hum.Health=hum.MaxHealth end
            RunService.Heartbeat:Wait()
        end
        ethSetVoidMode(false)
        local tHRP=EthResolver.Target.Character:FindFirstChild("HumanoidRootPart")
        if tHRP and EthResolver.Active and EthResolver.State.skyDiveActive and not EthResolver.State.stomping then
            EthResolver.State.attached=true; EthResolver.State.currentOffsetDir=ethRandomDir()
            local offsetPos=tHRP.Position+EthResolver.State.currentOffsetDir*ETH_CFG.OFFSET_DISTANCE
            hrp.CFrame=CFrame.lookAt(offsetPos,tHRP.Position)
            task.wait(ETH_CFG.GROUND_TIME)
        else EthResolver.State.skyDiveActive=false end
    end
    ethSetVoidMode(false); EthResolver.State.attached=false
end
local function ethHeartbeatFn(dt)
    if not EthResolver.Active or not EthResolver.Target then return end
    local char=LP.Character; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    if EthResolver.State.voidFrozen then
        local vCF=CFrame.new(hrp.Position.X,ETH_CFG.VOID_HEIGHT,hrp.Position.Z)
        hrp.CFrame=vCF
        hrp.AssemblyLinearVelocity=Vector3.zero  -- BUG#8 fix
        hrp.AssemblyAngularVelocity=Vector3.zero
        return
    end
    local tChar=EthResolver.Target.Character; if not tChar then return end
    local be=tChar:FindFirstChild("BodyEffects")
    local isKO=be and be:FindFirstChild("K.O") and be["K.O"].Value
    local isDead_=be and be:FindFirstChild("Dead") and be["Dead"].Value
    if isKO and not isDead_ and EthResolver.StompEnabled and not EthResolver.State.stomping then
        EthResolver.State.stomping=true; EthResolver.State.attached=false; EthResolver.State.skyDiveActive=false; ethSetVoidMode(false)
    end
    if EthResolver.State.stomping then
        pcall(function() if HAS_SETHIDDEN then sethiddenproperty(hrp,"NetworkOwnership",LP) end end)
        local top=tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso") or tChar:FindFirstChild("HumanoidRootPart")
        if top then
            local sp=top.Position+Vector3.new(0,ETH_CFG.STOMP_HEIGHT,0)
            hrp.CFrame=CFrame.new(sp)
            hrp.AssemblyLinearVelocity=Vector3.zero  -- BUG#8 fix
            hrp.AssemblyAngularVelocity=Vector3.zero
            if tick()-EthResolver.State.lastStompSpam>ETH_CFG.STOMP_SPAM_INTERVAL then
                for _=1,ETH_CFG.STOMP_SPAM_COUNT do
                    pcall(function()
                        local mainEvent = ReplicatedStorage:FindFirstChild("MainEvent")
                        if mainEvent then
                            mainEvent:FireServer("Stomp")
                        end
                    end)
                end
                EthResolver.State.lastStompSpam=tick()
            end
        end
        if isDead_ then
            EthResolver.State.stomping=false; EthResolver.State.voidFrozen=true; ethSetVoidMode(true)
            local vCF=CFrame.new(hrp.Position.X,ETH_CFG.VOID_HEIGHT,hrp.Position.Z)
            hrp.CFrame=vCF
            hrp.AssemblyLinearVelocity=Vector3.zero  -- BUG#8 fix
            hrp.AssemblyAngularVelocity=Vector3.zero
        end; return
    end
    if EthResolver.State.attached then
        local tHRP=tChar:FindFirstChild("HumanoidRootPart"); if not tHRP then EthResolver.State.attached=false; return end
        pcall(function()
            if HAS_SETHIDDEN then sethiddenproperty(hrp,"NetworkOwnership",LP); sethiddenproperty(tHRP,"NetworkOwnership",LP) end
            EthResolver.State.positionSwitchTimer=EthResolver.State.positionSwitchTimer+dt
            if EthResolver.State.positionSwitchTimer>=ETH_CFG.POSITION_SWITCH_INTERVAL then
                EthResolver.State.positionSwitchTimer=0; EthResolver.State.currentOffsetDir=ethRandomDir()
            end
            local offsetPos=tHRP.Position+EthResolver.State.currentOffsetDir*ETH_CFG.OFFSET_DISTANCE
            hrp.CFrame=CFrame.lookAt(offsetPos,tHRP.Position)
            hrp.AssemblyLinearVelocity=Vector3.zero  -- BUG#8 fix
            hrp.AssemblyAngularVelocity=Vector3.zero
        end)
        if isDead_ and not EthResolver.State.voidFrozen then
            EthResolver.State.attached=false; EthResolver.State.stomping=false; EthResolver.State.voidFrozen=true; ethSetVoidMode(true)
            local vCF=CFrame.new(hrp.Position.X,ETH_CFG.VOID_HEIGHT,hrp.Position.Z)
            hrp.CFrame=vCF
            hrp.AssemblyLinearVelocity=Vector3.zero  -- BUG#8 fix
            hrp.AssemblyAngularVelocity=Vector3.zero
        end
    end
end
local function ethRenderFn(dt)
    if not EthResolver.Active or not EthResolver.Target then
        if EthResolver.State.beam then EthResolver.State.beam.Enabled=false end; return
    end
    local tHRP=EthResolver.Target.Character and EthResolver.Target.Character:FindFirstChild("HumanoidRootPart")
    if tHRP then
        if not EthResolver.State.beam then
            EthResolver.State.a0=Instance.new("Attachment",workspace.Terrain)
            EthResolver.State.a1=Instance.new("Attachment",workspace.Terrain)
            EthResolver.State.beam=Instance.new("Beam",workspace)
            local beam=EthResolver.State.beam
            beam.Attachment0=EthResolver.State.a0; beam.Attachment1=EthResolver.State.a1
            beam.FaceCamera=true; beam.LightEmission=1; beam.LightInfluence=0
            beam.Segments=128; beam.Texture="rbxassetid://1217127707"
            beam.TextureLength=15; beam.TextureSpeed=16; beam.TextureMode=Enum.TextureMode.Wrap
            beam.Transparency=NumberSequence.new(0)
            beam.Width0=Flags.EthTracerThick; beam.Width1=Flags.EthTracerThick*0.5
        end
        local m=UserInputService:GetMouseLocation(); local ray=Camera:ViewportPointToRay(m.X,m.Y,0)
        EthResolver.State.a0.WorldCFrame=CFrame.new(ray.Origin+ray.Direction*10)
        EthResolver.State.a1.Parent=tHRP; EthResolver.State.beam.Enabled=true
        if Flags.EthTracerRainbow then
            EthResolver.State.hue=(EthResolver.State.hue+dt*0.1)%1
            EthResolver.State.beam.Color=ColorSequence.new(Color3.fromHSV(EthResolver.State.hue,1,1))
        else EthResolver.State.beam.Color=ColorSequence.new(fc("ColFH")) end
    else if EthResolver.State.beam then EthResolver.State.beam.Enabled=false end end
end
local function startEthResolver()
    if EthResolver.Active then
        EthResolver.Active=false
        for _,c in ipairs(EthResolver.Connections) do c:Disconnect() end; EthResolver.Connections={}
        ethSetVoidMode(false)
        if EthResolver.State.beam then EthResolver.State.beam:Destroy(); EthResolver.State.beam=nil end
        if EthResolver.State.a0 then EthResolver.State.a0:Destroy() end
        if EthResolver.State.a1 then EthResolver.State.a1:Destroy() end
        cOk("Eth Resolver stopped"); return
    end
    if not EthResolver.Target then cWarn("Set Eth Resolver target first"); return end
    EthResolver.Active=true; EthResolver.StompEnabled=Flags.EthResolverStomp
    EthResolver.State={attached=false,stomping=false,skyDiveActive=false,voidFrozen=false,storedProps={},
        lastStabTime=0,lastStompSpam=0,positionSwitchTimer=0,currentOffsetDir=Vector3.new(0,0,-1),beam=nil,a0=nil,a1=nil,hue=0}
    EthResolver.State.skyDiveActive=true
    task.spawn(ethSkyDiveLoop)
    table.insert(EthResolver.Connections,RunService.Heartbeat:Connect(ethHeartbeatFn))
    table.insert(EthResolver.Connections,RunService.RenderStepped:Connect(ethRenderFn))
    cOk("Eth Resolver started -> "..EthResolver.Target.Name)
end

-- ═══════════════════════════════════════════════════════════
-- [27] ASTRAL DESYNCS
-- ═══════════════════════════════════════════════════════════
local netDesyncPrevTick=tick(); local netDesyncSleep=false
local function doNetworkDesync()
    if not Flags.NetDesync then return end
    local char=LP.Character; if not (char and char:FindFirstChild("HumanoidRootPart")) then return end
    local hrp=char.HumanoidRootPart
    if Flags.NetDesyncWalk and LP.Character.Humanoid.MoveDirection.Magnitude==0 then return end
    if tick()-netDesyncPrevTick>=(Flags.NetDesyncAmount/math.pi)/10000 then
        netDesyncSleep=not netDesyncSleep; netDesyncPrevTick=tick()
        pcall(function() if HAS_SETHIDDEN then sethiddenproperty(hrp,"NetworkIsSleeping",netDesyncSleep) end end)
    end
end
local function doVelocityDesync()
    if not Flags.VelDesync then return end
    local char=LP.Character; if not (char and char:FindFirstChild("HumanoidRootPart")) then return end
    local hrp=char.HumanoidRootPart
    local vel=hrp.AssemblyLinearVelocity; local amt=Flags.VelDesyncRange*1000
    hrp.AssemblyLinearVelocity=Vector3.new(math.random(-amt,amt),math.random(-amt,amt),math.random(-amt,amt))  -- BUG#8 fix
    RunService.RenderStepped:Wait(); hrp.AssemblyLinearVelocity=vel  -- BUG#8 fix
end
local function doFFlagDesync()
    if not Flags.FFlagDesync or not HAS_SETFFLAG then return end
    setfflag("S2PhysicsSenderRate",tostring(Flags.FFlagDesyncAmt))
    RunService.RenderStepped:Wait()
end
local function doDaCoolBoy()
    if not Flags.DaCoolBoy or not HAS_SETFFLAG then return end
    setfflag("S2PhysicsSenderRate",1); setfflag("VisualizationImprovements",1)
    setfflag("VisualizeAllPropertyChanges",1); setfflag("VisualizerTrackRotationPredictions",1)
    setfflag("EnableInterpolationVisualizer",1); RunService.RenderStepped:Wait()
end

-- ═══════════════════════════════════════════════════════════
-- [28] ASTRAL VOIDHIDE
-- ═══════════════════════════════════════════════════════════
local VoidHideEnabled=false; local voidLastSafe=nil; local voidTeleporting=false
local voidLastTime=tick(); local voidBaitPos=nil; local voidBaitLastTime=tick()
local function doVoidHide()
    if not VoidHideEnabled then return end
    local char=LP.Character; if not (char and char:FindFirstChild("HumanoidRootPart")) then return end
    local hum=char:FindFirstChildOfClass("Humanoid"); if hum and hum.Health<=0 then return end
    if voidTeleporting then return end
    local hrp=char.HumanoidRootPart; local oldCF=hrp.CFrame
    local oldVel=hrp.AssemblyLinearVelocity  -- BUG#8 fix: was hrp.Velocity
    voidLastSafe=oldCF; local now=tick()
    if now-voidLastTime<0.05 then return end; voidLastTime=now
    voidTeleporting=true
    local pos
    if Flags.VoidHideType=="bait" then
        if now-voidBaitLastTime>0.5 then
            voidBaitLastTime=now; local bd=Flags.VoidHideBaitDist
            voidBaitPos=CFrame.new(math.random(-bd,bd),math.random(-200,200),math.random(-bd,bd))
        end
        pos=(voidBaitPos or CFrame.new(0,-1000,0))+Vector3.new(math.random(-Flags.VoidHideOffset,Flags.VoidHideOffset),math.random(-Flags.VoidHideOffset,Flags.VoidHideOffset),math.random(-Flags.VoidHideOffset,Flags.VoidHideOffset))
    else
        pos=CFrame.new(math.random(-2147483647,2147483647),math.random(-400,2147483647),math.random(-2147483647,2147483647))
    end
    hrp.CFrame=pos; task.wait(0.05)
    hrp.CFrame=voidLastSafe or oldCF
    hrp.AssemblyLinearVelocity=oldVel  -- BUG#8 fix: was hrp.Velocity=oldVel
    voidTeleporting=false
end

-- ═══════════════════════════════════════════════════════════
-- [29] ASTRAL CSYNC
-- ═══════════════════════════════════════════════════════════
local CSyncTarget=nil
local function getCSyncFrame()
    if not (Flags.CSyncEnable and CSyncTarget and CSyncTarget.Character) then return nil end
    local tHRP=CSyncTarget.Character:FindFirstChild("HumanoidRootPart"); if not tHRP then return nil end
    local tPos=tHRP.Position; local t=tick()
    local typ=Flags.CSyncType
    if typ=="Orbit" then
        return CFrame.new(tPos)*CFrame.Angles(0,2*math.pi*t*Flags.CSyncSpeed%(2*math.pi),0)*CFrame.new(0,Flags.CSyncHeight,Flags.CSyncDistance)
    elseif typ=="Spiral" then
        local ang=2*math.pi*t*Flags.CSyncSpeed%(2*math.pi); local r=Flags.CSyncDistance+math.sin(t)*Flags.CSyncRandom
        return CFrame.new(tPos)*CFrame.Angles(0,ang,0)*CFrame.new(r,Flags.CSyncHeight,0)
    elseif typ=="Random" then
        local rr=Flags.CSyncRandom
        return CFrame.new(tPos+Vector3.new(math.random(-rr,rr),math.random(0,rr),math.random(-rr,rr)))*CFrame.Angles(math.rad(math.random(0,360)),math.rad(math.random(0,360)),math.rad(math.random(0,360)))
    elseif typ=="Attach" and CSyncTarget and CSyncTarget.Character and CSyncTarget.Character:FindFirstChild("HumanoidRootPart") then
        local root=CSyncTarget.Character.HumanoidRootPart; return CFrame.new(root.Position+root.AssemblyLinearVelocity*0.1)
    end
    return CFrame.new(tPos)
end

-- ╔══════════════════════════════════════════════════════════╗
-- ║ BUG #6 FIX — CSync was defined but never called         ║
-- ║ doCSSync() now called in Heartbeat loop below           ║
-- ╚══════════════════════════════════════════════════════════╝
local function doCSSync()
    if not Flags.CSyncEnable or not CSyncTarget then return end
    local myChar=LP.Character; if not (myChar and myChar:FindFirstChild("HumanoidRootPart")) then return end
    local myHRP=myChar.HumanoidRootPart
    local cf=getCSyncFrame(); if not cf then return end
    pcall(function()
        if HAS_SETHIDDEN then sethiddenproperty(myHRP,"NetworkOwnership",LP) end
        myHRP.CFrame=cf
        myHRP.AssemblyLinearVelocity=Vector3.zero
        myHRP.AssemblyAngularVelocity=Vector3.zero
    end)
end

-- ═══════════════════════════════════════════════════════════
-- [30] ASTRAL MAGIC BULLET (ragebot)
-- ═══════════════════════════════════════════════════════════
local MB_lastFire=0; local MB_cooldown=0.05
RunService.Heartbeat:Connect(function()
    if not (Flags.MagicBullet and Flags.MagicBulletEnabled) then return end
    local rageTarg
    if Flags.MagicBulletTarg and clActive and clTarget then
        rageTarg=Players:GetPlayerFromCharacter(clTarget.Parent)
    else
        local best,bd=nil,math.huge; local center=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
        for _,p in ipairs(Players:GetPlayers()) do
            if p==LP or not p.Character then continue end
            local hum2=getHum(p.Character); if not hum2 or hum2.Health<=0 then continue end
            local hrp2=getRoot(p.Character); if not hrp2 then continue end
            local sp,on=Camera:WorldToViewportPoint(hrp2.Position); if not on then continue end
            local mag=(Vector2.new(sp.X,sp.Y)-center).Magnitude
            if mag<Flags.AimFOV and mag<bd then bd=mag; best=p end
        end
        rageTarg=best
    end
    if not rageTarg or not rageTarg.Character then return end
    local tHum=getHum(rageTarg.Character); if not tHum or tHum.Health<=0 then return end
    if rageTarg.Character:FindFirstChildOfClass("ForceField") then return end
    local myChar=LP.Character; if not myChar then return end
    local myHRP=myChar:FindFirstChild("HumanoidRootPart"); if not myHRP then return end
    local mainEv=ReplicatedStorage:FindFirstChild("MainEvent"); if not (mainEv and mainEv:IsA("RemoteEvent")) then return end
    local now=tick(); if now-MB_lastFire<MB_cooldown then return end; MB_lastFire=now
    local tp=rageTarg.Character:FindFirstChild("Head") or getRoot(rageTarg.Character); if not tp then return end
    local vel=tp.AssemblyLinearVelocity
    local aimPos=getPredPosHV(tp,vel,Flags.PredVal,Flags.PredVal,0)
    local dir=(aimPos-myHRP.Position).Unit
    local tools={}; for _,c in ipairs(myChar:GetChildren()) do if c:IsA("Tool") and c:FindFirstChild("Handle") then table.insert(tools,c) end end
    if #tools==0 then return end
    for _,tool in ipairs(tools) do
        local handle=tool.Handle; if not handle then continue end
        pcall(function()
            mainEv:FireServer("ShootGun",handle,handle.Position,aimPos,tp,dir)
        end)
    end
end)

-- ═══════════════════════════════════════════════════════════
-- [31] ASTRAL KILL AURA
-- ═══════════════════════════════════════════════════════════
RunService:BindToRenderStep("KillAura",100,function()
    if not Flags.KillAura then return end
    local mainEv=ReplicatedStorage:FindFirstChild("MainEvent"); if not mainEv then return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP or not p.Character then continue end
        local be=p.Character:FindFirstChild("BodyEffects"); local hrp2=getRoot(p.Character)
        if not (hrp2 and be) then continue end
        local ko=be:FindFirstChild("K.O")
        if ko and ko.Value==false then
            local myChar=LP.Character; if not myChar then continue end
            local myHRP=myChar:FindFirstChild("HumanoidRootPart"); if not myHRP then continue end
            if (hrp2.Position-myHRP.Position).Magnitude>100 then continue end
            local head=p.Character:FindFirstChild("Head"); if not head then continue end
            local tool=myChar:FindFirstChildOfClass("Tool"); if not (tool and tool:FindFirstChild("Handle")) then continue end
            local predPos=head.Position+head.AssemblyLinearVelocity*0.2  -- BUG#8 fix
            pcall(function()
                mainEv:FireServer("ShootGun",tool.Handle,myHRP.Position-Vector3.new(0,10,0),predPos-Vector3.new(0,25,0),head,(predPos-myHRP.Position).Unit)
            end)
        end
    end
end)

