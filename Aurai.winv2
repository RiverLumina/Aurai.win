-- [36] ASTRAL WEATHER SYSTEM
-- ═══════════════════════════════════════════════════════════
local WeatherPart=nil; local WeatherParticle=nil; local WeatherOffset=Vector3.new(0,20,0)
local WeatherTypes={
    rain={Speed=NumberRange.new(60,60),LockedToPart=true,Rate=600,Texture="rbxassetid://1822883048",
          EmissionDirection=Enum.NormalId.Bottom,LightEmission=0.05,LightInfluence=0.9,
          Orientation=Enum.ParticleOrientation.FacingCameraWorldUp,
          Size=NumberSequence.new({NumberSequenceKeypoint.new(0,10),NumberSequenceKeypoint.new(1,10)}),
          Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.25,0.78),NumberSequenceKeypoint.new(0.75,0.78),NumberSequenceKeypoint.new(1,1)}),
          Lifetime=NumberRange.new(0.8,0.8)},
    snow={Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.74),NumberSequenceKeypoint.new(0.97,0.77),NumberSequenceKeypoint.new(1,1)}),
          Texture="http://www.roblox.com/asset/?id=99851851",SpreadAngle=Vector2.new(50,50),
          Speed=NumberRange.new(30,30),LightEmission=0.5,Rate=1000,EmissionDirection=Enum.NormalId.Bottom,
          Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.33),NumberSequenceKeypoint.new(1,0.33)})},
}
local function toggleWeather(on)
    if WeatherPart then WeatherPart:Destroy(); WeatherPart=nil; WeatherParticle=nil end
    if on then
        WeatherPart=Instance.new("Part"); WeatherPart.Size=Vector3.new(40,40,85)
        WeatherPart.CanCollide=false; WeatherPart.Transparency=1; WeatherPart.Anchored=true; WeatherPart.Parent=workspace
        local data=WeatherTypes[Flags.WeatherType]
        if data then
            WeatherParticle=Instance.new("ParticleEmitter")
            for k,v in pairs(data) do pcall(function() WeatherParticle[k]=v end) end
            WeatherParticle.Color=ColorSequence.new(fc("ColWeather")); WeatherParticle.Parent=WeatherPart
        end
    end
end

-- ═══════════════════════════════════════════════════════════
-- [37] GLOW (SelectionBox)
-- ═══════════════════════════════════════════════════════════
local glowStore={}
local function clearGlow(p) local g=glowStore[p]; if g then pcall(function() g:Destroy() end) end; glowStore[p]=nil end
local function applyGlow(p,col)
    local char=p.Character; if not char then return end
    if glowStore[p] then
        if not glowStore[p].Parent then pcall(function() glowStore[p]:Destroy() end); glowStore[p]=nil
        else glowStore[p].Color3=col; glowStore[p].SurfaceColor3=col; return end
    end
    local g=Instance.new("SelectionBox"); g.Adornee=char; g.Color3=col; g.LineThickness=0.07
    g.SurfaceTransparency=1; g.SurfaceColor3=col; g.Parent=workspace; glowStore[p]=g
end

-- ═══════════════════════════════════════════════════════════
-- [38] HIGHLIGHT CHAMS
-- ═══════════════════════════════════════════════════════════
local hlStore={}
local HLChamsLocal=Instance.new("Highlight"); HLChamsLocal.FillTransparency=0.5; HLChamsLocal.OutlineTransparency=0
HLChamsLocal.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; HLChamsLocal.Enabled=false
local function getOrMakeHL(p)
    if hlStore[p] and hlStore[p].Parent then return hlStore[p] end
    local hl=Instance.new("Highlight"); hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor=fc("ColHLFill"); hl.OutlineColor=fc("ColHLOutline")
    hl.FillTransparency=Flags.HLChamsFill; hl.OutlineTransparency=Flags.HLChamsOutline
    hl.Enabled=false; hl.Parent=workspace; hlStore[p]=hl; return hl
end
local function tickHL()
    for p,hl in pairs(hlStore) do
        if not Players:FindFirstChild(p.Name) then pcall(function() hl:Destroy() end); hlStore[p]=nil; continue end
        local char=p.Character; local hum=char and getHum(char); local alive=hum and hum.Health>0
        if char and alive and Flags.HLChamsEnable then
            hl.Adornee=char; hl.Enabled=true
            local isT=(Target and Players:GetPlayerFromCharacter(Target)==p) or (clActive and clTarget and Players:GetPlayerFromCharacter(clTarget.Parent)==p)
            hl.FillColor=isEnemy(p) and fc("ColHLFill") or fc("ColTeam")
            if isT then hl.FillColor=fc("ColTarget") end
        else hl.Enabled=false end
    end
    local myChar=LP.Character
    if Flags.HLLocalEnable and myChar then
        HLChamsLocal.Adornee=myChar; HLChamsLocal.Enabled=true
    else HLChamsLocal.Enabled=false end
end
for _,p in ipairs(Players:GetPlayers()) do if p~=LP then getOrMakeHL(p) end end
Players.PlayerAdded:Connect(function(p) task.wait(1); if p~=LP then getOrMakeHL(p) end end)
Players.PlayerRemoving:Connect(function(p) local hl=hlStore[p]; if hl then pcall(function() hl:Destroy() end); hlStore[p]=nil end end)

-- ═══════════════════════════════════════════════════════════
-- [39] SELECTION BOX CHAMS
-- ═══════════════════════════════════════════════════════════
local chamsStore={}
local CHAM_PARTS={"Head","UpperTorso","LowerTorso","Torso","LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm","LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg","Left Arm","Right Arm","Left Leg","Right Leg"}
local function clearChams(p)
    local d=chamsStore[p]; if not d then return end
    for _,b in ipairs(d.vis) do pcall(function() b:Destroy() end) end
    for _,b in ipairs(d.wall) do pcall(function() b:Destroy() end) end
    chamsStore[p]=nil
end
local function applyChams(p)
    if chamsStore[p] then return end
    local char=p.Character; if not char then return end
    local vis,wall={},{}
    for _,pn in ipairs(CHAM_PARTS) do
        local part=char:FindFirstChild(pn); if not part then continue end
        local bv=Instance.new("SelectionBox"); bv.Adornee=part; bv.Color3=fc("ColChamsVis"); bv.LineThickness=0.04
        bv.SurfaceTransparency=0.5; bv.SurfaceColor3=fc("ColChamsVis"); bv.Parent=workspace; table.insert(vis,bv)
        local bw=Instance.new("SelectionBox"); bw.Adornee=part; bw.Color3=fc("ColChamsWall"); bw.LineThickness=0.02
        bw.SurfaceTransparency=0.75; bw.SurfaceColor3=fc("ColChamsWall"); bw.Parent=workspace; table.insert(wall,bw)
    end
    chamsStore[p]={vis=vis,wall=wall}
end
local function tickChams()
    for p,d in pairs(chamsStore) do
        local char=p.Character; local hum=char and getHum(char); local alive=hum and hum.Health>0
        for _,b in ipairs(d.vis) do b.Visible=alive and Flags.ChamsEnable and Flags.ChamsVisible end
        for _,b in ipairs(d.wall) do b.Visible=alive and Flags.ChamsEnable and Flags.ChamsWall end
    end
end

-- ═══════════════════════════════════════════════════════════
-- [40] SKELETON ESP
-- ═══════════════════════════════════════════════════════════
local BONES_R15={{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}}
local BONES_R6={{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"}}

-- ═══════════════════════════════════════════════════════════
-- [41] ESP DRAWING OBJECTS
-- ═══════════════════════════════════════════════════════════
local espObjs={}
local function clearEspPlayer(p)
    local d=espObjs[p]; if not d then return end
    for _,v in pairs(d) do
        if type(v)=="table" then for _,l in pairs(v) do pcall(function() l:Remove() end) end
        elseif v then pcall(function() v:Remove() end) end
    end
    espObjs[p]=nil
end
local function clearAllEsp() for p in pairs(espObjs) do clearEspPlayer(p) end end

local fovCircle=nil; local fovOuter=nil; local fovInner=nil
local function ensureFovCircles()
    if not HAS_DRAWING then return end
    if Flags.FOVDualRing then
        if not fovOuter then fovOuter=mkCircle(0,0,Flags.AimFOV+1,Color3.new(0,0,0),Flags.FOVThickness+1,false,64) end
        if not fovInner then fovInner=mkCircle(0,0,Flags.AimFOV,fc("ColFOV"),Flags.FOVThickness,Flags.FOVFilled,64) end
    else
        if not fovCircle then fovCircle=mkCircle(0,0,Flags.AimFOV,fc("ColFOV"),Flags.FOVThickness,Flags.FOVFilled,64) end
    end
end
local function updateFovCircle()
    if not Flags.FOVShow or not Flags.AimEnable then
        if fovCircle then pcall(function() fovCircle.Visible=false end) end
        if fovOuter then pcall(function() fovOuter.Visible=false end) end
        if fovInner then pcall(function() fovInner.Visible=false end) end
        return
    end
    ensureFovCircles()
    local ml=UserInputService:GetMouseLocation()
    local function upd(c,r,col,th,filled)
        if c then c.Position=Vector2.new(ml.X,ml.Y); c.Radius=r; c.Color=col; c.Thickness=th; c.Filled=filled; c.Visible=true end
    end
    if Flags.FOVDualRing then
        upd(fovOuter,Flags.AimFOV+1,fc("ColFOVOuter"),Flags.FOVThickness+1,false)
        upd(fovInner,Flags.AimFOV,fc("ColFOV"),Flags.FOVThickness,Flags.FOVFilled)
    else upd(fovCircle,Flags.AimFOV,fc("ColFOV"),Flags.FOVThickness,Flags.FOVFilled) end
end

-- ═══════════════════════════════════════════════════════════
-- [42] HIT MARKER
-- ═══════════════════════════════════════════════════════════
local hitMarkers={}
local function spawnHitMark(lethal)
    if not Flags.HitMark or not HAS_DRAWING then return end
    local cx=Camera.ViewportSize.X/2; local cy=Camera.ViewportSize.Y/2
    local col=lethal and Color3.fromRGB(255,50,50) or fc("ColHitMark"); local sz=lethal and 10 or 7; local lines={}
    for _,o in ipairs({{-sz,-sz,sz,sz},{sz,-sz,-sz,sz}}) do
        local l=mkLine(cx+o[1],cy+o[2],cx+o[3],cy+o[4],col,1.5); if l then table.insert(lines,l) end
    end
    table.insert(hitMarkers,{lines=lines,t=tick()})
end

-- ═══════════════════════════════════════════════════════════
-- [43] RADAR
-- ═══════════════════════════════════════════════════════════
local radarGui,radarFrame,radarDots=nil,nil,{}
local function buildRadar()
    if radarGui then return end
    radarGui=Instance.new("ScreenGui"); radarGui.Name="AuraiRadar"; radarGui.ResetOnSpawn=false
    radarGui.IgnoreGuiInset=true; radarGui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    radarFrame=Instance.new("Frame"); radarFrame.Size=UDim2.new(0,160,0,160)
    radarFrame.Position=UDim2.new(1,-180,1,-180); radarFrame.BackgroundColor3=Color3.fromRGB(8,8,14)
    radarFrame.BackgroundTransparency=0.3; radarFrame.BorderSizePixel=0; radarFrame.Parent=radarGui
    Instance.new("UICorner",radarFrame).CornerRadius=UDim.new(0,8)
    local border=Instance.new("UIStroke"); border.Color=fc("ColRadar"); border.Thickness=1.5; border.Parent=radarFrame
    for _,v in ipairs({{0,0.5,1,0.5},{0.5,0,0.5,1}}) do
        local l=Instance.new("Frame"); l.BackgroundColor3=Color3.new(1,1,1); l.BackgroundTransparency=0.88
        l.BorderSizePixel=0; l.Position=UDim2.new(v[1],0,v[2],0); l.Size=UDim2.new(v[3]-v[1],0,v[4]-v[2],1); l.Parent=radarFrame
    end
    local sd=Instance.new("Frame"); sd.Size=UDim2.new(0,7,0,7); sd.AnchorPoint=Vector2.new(0.5,0.5)
    sd.Position=UDim2.new(0.5,0,0.5,0); sd.BackgroundColor3=Color3.fromRGB(80,220,80); sd.BorderSizePixel=0; sd.Parent=radarFrame
    Instance.new("UICorner",sd).CornerRadius=UDim.new(1,0)
    radarGui.Parent=LP.PlayerGui
end
local function destroyRadar() if radarGui then radarGui:Destroy(); radarGui=nil; radarFrame=nil; radarDots={} end end

-- ═══════════════════════════════════════════════════════════
-- [44] HITBOX EXPANDER
-- ═══════════════════════════════════════════════════════════
local hbConn=nil
local function startHitboxExpander()
    if hbConn then return end
    hbConn=RunService.Heartbeat:Connect(function()
        if not Flags.HitboxExpander then hbConn:Disconnect(); hbConn=nil; return end
        for _,p in ipairs(Players:GetPlayers()) do
            if p==LP then continue end
            local char=p.Character; if not char then continue end
            local hum=getHum(char); if not hum then continue end
            local hrp=hum.RootPart or getRoot(char); if not hrp then continue end
            hrp.CanCollide=false
            pcall(function() hrp.Size=Vector3.new(Flags.HitboxSize,Flags.HitboxSize,Flags.HitboxSize) end)
        end
    end)
end

-- ═══════════════════════════════════════════════════════════
-- [45] MOVEMENT
-- ═══════════════════════════════════════════════════════════
UserInputService.JumpRequest:Connect(function()
    if not Flags.BhopEnable then return end
    local char=LP.Character; if not char then return end
    local hum=getHum(char); if not hum then return end
    if hum:GetState()==Enum.HumanoidStateType.Landed then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
end)

local antiVoidLastSafe=nil
local function antiVoidV2()
    if not Flags.AntiVoidV2 then return end
    local char=LP.Character; if not (char and char:FindFirstChild("HumanoidRootPart")) then return end
    local hrp=char.HumanoidRootPart; local pos=hrp.Position
    local rp=RaycastParams.new(); rp.FilterDescendantsInstances={char}; rp.FilterType=Enum.RaycastFilterType.Exclude
    if not workspace:Raycast(pos,Vector3.new(0,-500,0),rp) then
        if pos.Y<-50 then
            if antiVoidLastSafe then
                hrp.CFrame=antiVoidLastSafe
                hrp.AssemblyLinearVelocity=Vector3.zero  -- BUG#8 fix
                hrp.AssemblyAngularVelocity=Vector3.zero
            else hrp.CFrame=CFrame.new(0,100,0) end
        end
    else antiVoidLastSafe=hrp.CFrame end
end
local function antiVoidSimple()
    if not Flags.AntiVoid then return end
    local char=LP.Character; local hrp=char and getRoot(char); if not hrp then return end
    if hrp.Position.Y>-50 then antiVoidLastSafe=hrp.CFrame
    elseif antiVoidLastSafe and hrp.Position.Y<-100 then hrp.CFrame=antiVoidLastSafe end
end

-- ═══════════════════════════════════════════════════════════
-- [46] AURA SYSTEM (BUG #9 FIX — full implementation)
-- ═══════════════════════════════════════════════════════════
-- ╔══════════════════════════════════════════════════════════╗
-- ║ BUG #9 FIX — Aura system was flagged but never built    ║
-- ║ applyAura() now implemented with ParticleEmitters       ║
-- ╚══════════════════════════════════════════════════════════╝
local AuraAttachments={}; local AuraEmitters={}
local function clearAura(char)
    for _,a in ipairs(AuraAttachments[char] or {}) do pcall(function() a:Destroy() end) end
    for _,e in ipairs(AuraEmitters[char] or {}) do pcall(function() e:Destroy() end) end
    AuraAttachments[char]=nil; AuraEmitters[char]=nil
end
local function applyAura(char)
    if not (char and char:FindFirstChild("HumanoidRootPart")) then return end
    if AuraAttachments[char] then return end
    local hrp=char.HumanoidRootPart
    local atts={}; local emits={}
    local AuraTypeConfigs={
        custom={
            Size=NumberSequence.new({NumberSequenceKeypoint.new(0,Flags.AuraSize),NumberSequenceKeypoint.new(1,0)}),
            Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.5),NumberSequenceKeypoint.new(1,1)}),
            LightEmission=1,LightInfluence=0,Speed=NumberRange.new(Flags.AuraSpeed,Flags.AuraSpeed*1.5),
            Lifetime=NumberRange.new(1.2,1.8),Rate=25,SpreadAngle=Vector2.new(360,360),
            Texture="rbxassetid://1084991215",
        },
        smoke={
            Size=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,Flags.AuraSize*2)}),
            Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.3),NumberSequenceKeypoint.new(1,1)}),
            LightEmission=0,LightInfluence=1,Speed=NumberRange.new(Flags.AuraSpeed*0.5,Flags.AuraSpeed),
            Lifetime=NumberRange.new(2,3),Rate=15,SpreadAngle=Vector2.new(90,90),
            Texture="rbxassetid://8708637750",
        },
        spark={
            Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.3),NumberSequenceKeypoint.new(0.5,Flags.AuraSize*0.5),NumberSequenceKeypoint.new(1,0)}),
            Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)}),
            LightEmission=1,LightInfluence=0,Speed=NumberRange.new(Flags.AuraSpeed*2,Flags.AuraSpeed*4),
            Lifetime=NumberRange.new(0.4,0.8),Rate=40,SpreadAngle=Vector2.new(360,360),
            Texture="rbxassetid://446111271",
        },
    }
    local cfg=AuraTypeConfigs[Flags.AuraType] or AuraTypeConfigs.custom
    local att=Instance.new("Attachment"); att.Parent=hrp; table.insert(atts,att)
    local e=Instance.new("ParticleEmitter")
    e.Color=ColorSequence.new(fc("ColAura"))
    e.Size=cfg.Size; e.Transparency=cfg.Transparency; e.LightEmission=cfg.LightEmission
    e.LightInfluence=cfg.LightInfluence; e.Speed=cfg.Speed; e.Lifetime=cfg.Lifetime
    e.Rate=cfg.Rate; e.SpreadAngle=cfg.SpreadAngle; e.Texture=cfg.Texture
    e.LockedToPart=true; e.Brightness=2
    e.Parent=att; table.insert(emits,e)
    AuraAttachments[char]=atts; AuraEmitters[char]=emits
end

-- ═══════════════════════════════════════════════════════════
-- [47] MAIN HEARTBEAT LOOP
-- ═══════════════════════════════════════════════════════════
RunService.Heartbeat:Connect(function(dt)
    if Flags.WalkSpeed then
        local char=LP.Character; local hum=char and getHum(char)
        if hum then hum.WalkSpeed=Flags.WalkSpeedVal end
    end
    if Flags.CFrameFlyEnable then
        local char=LP.Character; local hrp=char and getRoot(char)
        local hum=char and getHum(char)
        if hrp and hum then
            hrp.AssemblyLinearVelocity=Vector3.zero  -- BUG#8 fix
            local mv=Vector3.zero; local cam=Camera.CFrame
            if not UserInputService:GetFocusedTextBox() then
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv=mv+cam.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv=mv-cam.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv=mv-cam.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv=mv+cam.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv=mv+Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then mv=mv-Vector3.new(0,1,0) end
            end
            if mv.Magnitude>0 then
                local speed=Flags.CFrameFlySpeed/10*(dt*60)
                hrp.CFrame=hrp.CFrame+mv.Unit*speed
            end
        end
    end
    antiVoidSimple(); antiVoidV2()
    if Flags.AntiAim then
        local char=LP.Character; local hrp=char and getRoot(char)
        if hrp then
            local angle=math.sin(tick()*20)*Flags.AntiAimAngle
            hrp.CFrame=hrp.CFrame*CFrame.fromEulerAnglesXYZ(0,math.rad(angle),0)
        end
    end
    doAntiLock()
    if Flags.RemoveSeats then
        local char=LP.Character; local hum=char and getHum(char)
        if hum and hum.Sit then hum.Sit=false; hum.Jump=true end
    end
    autoReloadCheck()
    doVoidHide()
    doNetworkDesync(); doVelocityDesync(); doFFlagDesync(); doDaCoolBoy()
    doTargetStrafe()
    -- BUG #6 FIX: CSync now actually called
    doCSSync()
    if WeatherPart then WeatherPart.CFrame=CFrame.new(Camera.CFrame.Position)+WeatherOffset end
    if Flags.CrosshairEnable then
        if Flags.CrosshairSpin then crosshairAngle=crosshairAngle+dt*(Flags.CrosshairSpinSpeed/10) end
        if Flags.CrosshairResize then
            crosshairLen=crosshairLen+crosshairGrowDir*dt*(Flags.CrosshairSpinSpeed/50)
            if crosshairLen>=Flags.CrosshairResMax then crosshairGrowDir=-1
            elseif crosshairLen<=Flags.CrosshairResMin then crosshairGrowDir=1 end
        end
        updateCrosshair()
    end
end)

-- ═══════════════════════════════════════════════════════════
-- [48] MAIN RENDER LOOP
-- ═══════════════════════════════════════════════════════════
RunService.RenderStepped:Connect(function(dt)
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        if Flags.ESPGlow then
            local isT=(Target and Players:GetPlayerFromCharacter(Target)==p)
                   or (clActive and clTarget and Players:GetPlayerFromCharacter(clTarget.Parent)==p)
            local col=isEnemy(p) and fc("ColEnemy") or fc("ColTeam"); if isT then col=fc("ColTarget") end
            applyGlow(p,col)
        else clearGlow(p) end
        if Flags.ChamsEnable then applyChams(p) else clearChams(p) end
    end
    tickChams(); tickHL()

    local now=tick()
    for i=#hitMarkers,1,-1 do
        local hm=hitMarkers[i]; local age=now-hm.t
        if age>0.22 then for _,l in ipairs(hm.lines) do pcall(function() l:Remove() end) end; table.remove(hitMarkers,i)
        else local a=1-age/0.22; for _,l in ipairs(hm.lines) do l.Transparency=1-a end end
    end
    updateFovCircle()
    doCamLock()

    local myChar=LP.Character
    -- Wings
    if myChar then
        if Flags.WingsEnable then
            applyWings(myChar)
            -- ╔══════════════════════════════════════════════╗
            -- ║ BUG #7 FIX — WingsPulse now modulates Rate  ║
            -- ╚══════════════════════════════════════════════╝
            if Flags.WingsPulse then
                local emits=WingEmitters[myChar]
                if emits then
                    local pulse=math.abs(math.sin(tick()*Flags.WingsPulseSpeed))
                    for _,e in ipairs(emits) do
                        pcall(function() e.Rate=math.floor(pulse*12)+1 end)
                    end
                end
            end
        else clearWings(myChar) end
        -- Aura (BUG #9 FIX)
        if Flags.AuraEnable then applyAura(myChar) else clearAura(myChar) end
    end

    -- ESP
    if Flags.ESPEnable and HAS_DRAWING then
        for _,p in ipairs(Players:GetPlayers()) do
            if p==LP then continue end
            clearEspPlayer(p)
            local char=p.Character; if not char then continue end
            local hum=getHum(char); if not hum or hum.Health<=0 then continue end
            local hrp=getRoot(char); if not hrp then continue end
            local head=char:FindFirstChild("Head") or hrp
            local hrpVP,inV,depth=Camera:WorldToViewportPoint(hrp.Position)
            if not inV or depth<0 then continue end
            local topVP=Camera:WorldToViewportPoint(head.Position+Vector3.new(0,0.5,0))
            local bottomVP=Camera:WorldToViewportPoint(hrp.Position-Vector3.new(0,3,0))
            local shoulder=2
            local leftVP=Camera:WorldToViewportPoint(hrp.Position-Camera.CFrame.RightVector*shoulder/2)
            local rightVP=Camera:WorldToViewportPoint(hrp.Position+Camera.CFrame.RightVector*shoulder/2)
            local boxW=math.abs(rightVP.X-leftVP.X); local boxH=math.abs(topVP.Y-bottomVP.Y)
            local boxX=hrpVP.X-boxW/2; local boxY=topVP.Y
            local isT=(Target and Players:GetPlayerFromCharacter(Target)==p)
                   or (clActive and clTarget and Players:GetPlayerFromCharacter(clTarget.Parent)==p)
            local col
            if Flags.ESPTeamColour then
                local ok,tc=pcall(function() return p.TeamColor.Color end); col=ok and tc or fc("ColEnemy")
            else col=isEnemy(p) and fc("ColEnemy") or fc("ColTeam"); if isT then col=fc("ColTarget") end end
            local d={}; espObjs[p]=d
            if Flags.ESPBox then d.box=mkSquare(boxX,boxY,boxW,boxH,col,Flags.ESPThickness,false) end
            if Flags.ESPName then
                local lbl=isT and ("[TARGET] "..p.Name.." [TARGET]") or ("@"..p.Name)
                d.name=mkTxt(lbl,hrpVP.X,boxY+boxH+2,col,13,true)
            end
            if Flags.ESPHealth then d.health=mkTxt(string.format("[%.0f%%]",hum.Health/hum.MaxHealth*100),hrpVP.X,boxY-14,col,12,true) end
            if Flags.ESPDistance then
                local dist=math.floor((Camera.CFrame.Position-hrp.Position).Magnitude)
                d.dist=mkTxt("["..dist.."m]",hrpVP.X,hrpVP.Y+2,col,11,true)
            end
            if Flags.ESPTracer then
                d.tracer=mkLine(Camera.ViewportSize.X/2,Camera.ViewportSize.Y,hrpVP.X,boxY,fc("ColTracer"),Flags.ESPThickness)
            end
            if Flags.ESPHealthBar then
                local hpR=math.clamp(hum.Health/hum.MaxHealth,0,1); local barH=boxH*hpR
                local barX=boxX-5; local barY=boxY+boxH-barH
                d.hpBg=mkSquare(barX-1,boxY-1,4,boxH+2,Color3.new(0,0,0),1,true)
                d.hpBar=mkSquare(barX,barY,2,barH,fc("ColHealthBar"),1,true)
            end
            if Flags.ESPSkeleton then
                local isR15=char:FindFirstChild("UpperTorso")~=nil
                local boneMap=isR15 and BONES_R15 or BONES_R6; d.skel={}
                for _,pair in ipairs(boneMap) do
                    local pa=char:FindFirstChild(pair[1]); local pb=char:FindFirstChild(pair[2])
                    if pa and pb then
                        local a2,aV=Camera:WorldToViewportPoint(pa.Position)
                        local b2,bV=Camera:WorldToViewportPoint(pb.Position)
                        if aV and bV then
                            local l=mkLine(a2.X,a2.Y,b2.X,b2.Y,fc("ColSkeleton"),Flags.ESPSkeletonThick)
                            if l then table.insert(d.skel,l) end
                        end
                    end
                end
            end
        end
    else clearAllEsp() end

    -- Radar
    if not Flags.RadarEnable then if radarGui then destroyRadar() end
    else
        if not radarGui then buildRadar() end
        local myHRP=LP.Character and getRoot(LP.Character)
        if myHRP then
            local myCF=myHRP.CFrame; local myYaw=math.atan(myCF.LookVector.X,-myCF.LookVector.Z)
            for p,dot in pairs(radarDots) do if not Players:FindFirstChild(p.Name) then dot:Destroy(); radarDots[p]=nil end end
            for _,p in ipairs(Players:GetPlayers()) do
                if p==LP then continue end
                local char=p.Character; if not char then continue end
                local hrp2=getRoot(char); if not hrp2 then continue end
                local hum2=getHum(char); if not hum2 or hum2.Health<=0 then if radarDots[p] then radarDots[p]:Destroy(); radarDots[p]=nil end; continue end
                local dotCol=isEnemy(p) and fc("ColRadar") or Color3.fromRGB(80,220,80)
                if not radarDots[p] then
                    local dot=Instance.new("Frame"); dot.Size=UDim2.new(0,7,0,7); dot.AnchorPoint=Vector2.new(0.5,0.5)
                    dot.BackgroundColor3=dotCol; dot.BorderSizePixel=0; dot.Parent=radarFrame
                    Instance.new("UICorner",dot).CornerRadius=UDim.new(1,0); radarDots[p]=dot
                end
                radarDots[p].BackgroundColor3=dotCol
                local delta=hrp2.Position-myHRP.Position
                local cos=math.cos(-myYaw); local sin=math.sin(-myYaw)
                local rx=delta.X*cos-delta.Z*sin; local rz=delta.X*sin+delta.Z*cos
                radarDots[p].Position=UDim2.new(math.clamp(0.5+rx*0.08,0.05,0.95),0,math.clamp(0.5+rz*0.08,0.05,0.95),0)
            end
        end
    end
    applyWorldVisuals()
end)

-- LMB hit marker
UserInputService.InputBegan:Connect(function(input,gpe)
    if gpe then return end
    if input.UserInputType==Enum.UserInputType.MouseButton1 then spawnHitMark(false) end
end)

-- ═══════════════════════════════════════════════════════════
-- [49] AIMBOT LOOP (Heartbeat)
-- ═══════════════════════════════════════════════════════════
RunService.Heartbeat:Connect(function()
    if Flags.SpinBot then
        local char=LP.Character; local hrp=char and getRoot(char)
        if hrp then hrp.CFrame=hrp.CFrame*CFrame.fromEulerAnglesXYZ(0,math.rad(Flags.SpinSpeed),0) end
    end
    if IS_DAHOOD and DH_Remote and Flags.DH_FH then
        local best,bestDist=nil,math.huge; local mousePos=UserInputService:GetMouseLocation()
        for _,p in ipairs(Players:GetPlayers()) do
            if p==LP or not dh_shouldTarget(p) then continue end
            local char=p.Character; if not char then continue end
            local tp=char:FindFirstChild(Flags.DH_FHHitPart) or char:FindFirstChild("Head"); if not tp then continue end
            local sp,inV=Camera:WorldToViewportPoint(tp.Position)
            if inV then local dist=(Vector2.new(sp.X,sp.Y)-mousePos).Magnitude; if dist<bestDist then bestDist=dist; best=p end end
        end
        if best then dh_fire(best) end
    end
    if IS_DAHOOD and DH_Remote and Flags.DH_AutoStomp then
        for _,p in ipairs(Players:GetPlayers()) do
            if p==LP then continue end
            if dh_isKnocked(p) and not dh_isDead(p) then
                local char=p.Character; if not char then continue end
                local hrp2=getRoot(char); if not hrp2 then continue end
                local myHRP=LP.Character and getRoot(LP.Character); if not myHRP then continue end
                if (myHRP.Position-hrp2.Position).Magnitude<15 then
                    pcall(function() DH_Remote:FireServer("Stomp") end)
                end
            end
        end
    end
    if not Flags.AimEnable or not Aiming then
        if AimTween then AimTween:Cancel(); AimTween=nil end
        UserInputService.MouseDeltaSensitivity=SavedMouseSens; return
    end
    if not isReady(Target) then
        local closest=math.huge; Target=nil; local mousePos=UserInputService:GetMouseLocation()
        for _,p in ipairs(Players:GetPlayers()) do
            if p==LP then continue end
            local char=p.Character; if not char then continue end
            local ok,_,vpPos=isReady(char)
            if ok and vpPos then
                local dx=vpPos.X-mousePos.X; local dy=vpPos.Y-mousePos.Y
                local mag=math.sqrt(dx*dx+dy*dy); if mag<closest then closest=mag; Target=char end
            end
        end
    end
    local ok,_,vpPos,worldPos,_,predVP=isReady(Target); if not ok then resetAimbot(false); return end
    local mode=Flags.AimMode
    if mode=="Camera" then
        UserInputService.MouseDeltaSensitivity=0
        if Flags.AimSmooth then
            if AimTween then AimTween:Cancel() end
            AimTween=TweenService:Create(Camera,TweenInfo.new(math.clamp(Flags.AimSmoothVal,1,99)/100,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),{CFrame=CFrame.new(Camera.CFrame.Position,worldPos)})
            AimTween:Play()
        else Camera.CFrame=CFrame.new(Camera.CFrame.Position,worldPos) end
    elseif mode=="Mouse" and HAS_MOUSEMOVE then
        if AimTween then AimTween:Cancel(); AimTween=nil end
        UserInputService.MouseDeltaSensitivity=SavedMouseSens
        local mousePos=UserInputService:GetMouseLocation()
        local tx=predVP and predVP.X or vpPos.X; local ty=predVP and predVP.Y or vpPos.Y
        local sens=Flags.AimSmooth and math.clamp(Flags.AimSmoothVal,1,99)/10 or 1
        mousemoverel((tx-mousePos.X)/sens,(ty-mousePos.Y)/sens)
    elseif mode=="Silent" and HAS_HOOKMETHOD then
        UserInputService.MouseDeltaSensitivity=SavedMouseSens
    end
end)

-- ═══════════════════════════════════════════════════════════
-- [50] RAYFIELD UI
-- ═══════════════════════════════════════════════════════════
local LoadT=tick()
local Window=Rayfield:CreateWindow({
    name="aurai.win",
    subtitle="v9.0 FIXED  |  HvH Edition  |  "..GRI.Name,
    sidebarLayout=true,
    theme="cobalt",
    configuration={autoSave=true,autoLoad=true,fileName="AuraiWin_v90"},
})

local aimModes={"Camera"}
if HAS_MOUSEMOVE then table.insert(aimModes,"Mouse") end
if HAS_HOOKMETHOD then table.insert(aimModes,"Silent") end

local TabAim=Window:CreateTab({name="Aimbot",icon=93364949241311})
TabAim:CreateSection({name="Main"})
