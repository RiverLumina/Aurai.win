-- ═══════════════════════════════════════════════════════════
-- [8] DRAWING HELPERS
-- ═══════════════════════════════════════════════════════════
local function mkLine(x1,y1,x2,y2,col,th)
    if not HAS_DRAWING then return nil end
    local ok,l=pcall(function()
        local l=Drawing.new("Line"); l.From=Vector2.new(x1,y1); l.To=Vector2.new(x2,y2)
        l.Color=col; l.Thickness=th or 1; l.Visible=true; return l
    end); return ok and l or nil
end
local function mkTxt(txt,x,y,col,sz,center)
    if not HAS_DRAWING then return nil end
    local ok,t=pcall(function()
        local t=Drawing.new("Text"); t.Text=txt; t.Position=Vector2.new(x,y)
        t.Color=col or Color3.new(1,1,1); t.Size=sz or 13; t.Font=DRAW_FONT
        t.Outline=true; t.Center=center or false; t.Visible=true; return t
    end); return ok and t or nil
end
local function mkCircle(cx,cy,r,col,th,filled,sides)
    if not HAS_DRAWING then return nil end
    local ok,c=pcall(function()
        local c=Drawing.new("Circle"); c.Position=Vector2.new(cx,cy); c.Radius=r
        c.Color=col; c.Filled=filled or false; c.Thickness=th or 1; c.NumSides=sides or 64; c.Visible=true; return c
    end); return ok and c or nil
end
local function mkSquare(x,y,w,h,col,th,filled)
    if not HAS_DRAWING then return nil end
    local ok,s=pcall(function()
        local s=Drawing.new("Square"); s.Position=Vector2.new(x,y); s.Size=Vector2.new(w,h)
        s.Color=col; s.Thickness=th or 1; s.Filled=filled or false; s.Visible=true; return s
    end); return ok and s or nil
end

-- ═══════════════════════════════════════════════════════════
-- [9] CHARACTER HELPERS — R6/R15 universal
-- ═══════════════════════════════════════════════════════════
local function getRoot(char)
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
        or char:FindFirstChild("UpperTorso") or char:FindFirstChildOfClass("BasePart"))
end
local function getHum(char)
    return char and char:FindFirstChildWhichIsA("Humanoid")
end
local ALL_PARTS = {"Head","UpperTorso","HumanoidRootPart","LowerTorso",
    "LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm","LeftHand","RightHand",
    "LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg","LeftFoot","RightFoot",
    "Torso","Left Arm","Right Arm","Left Leg","Right Leg"}
local function getAimPart(char,partName)
    if not char then return nil end
    local name = partName or Flags.AimPart
    if name == "Closest Part" then
        local best,bd=nil,math.huge; local mp=UserInputService:GetMouseLocation()
        for _,n in ipairs(ALL_PARTS) do
            local p=char:FindFirstChild(n); if p then
                local sp,on=Camera:WorldToViewportPoint(p.Position)
                if on then local d=(Vector2.new(sp.X,sp.Y)-mp).Magnitude; if d<bd then bd=d; best=p end end
            end
        end
        return best
    end
    local p=char:FindFirstChild(name)
    if p and p:IsA("BasePart") then return p end
    for _,fn in ipairs({"Head","HumanoidRootPart","UpperTorso","Torso"}) do
        local fp=char:FindFirstChild(fn); if fp and fp:IsA("BasePart") then return fp end
    end
    return char:FindFirstChildOfClass("BasePart")
end
local function isEnemy(p)
    if p==LP then return false end
    if not Flags.AimTeamCheck then return true end
    local ok,r=pcall(function() return p.TeamColor~=LP.TeamColor end); return ok and r or true
end
local function isInAir(p)
    local char=p.Character; if not char then return false end
    local hum=getHum(char); if not hum then return false end
    local s=hum:GetState()
    return s==Enum.HumanoidStateType.Freefall or s==Enum.HumanoidStateType.Jumping
end
local function canSee(part)
    if not part then return false end
    local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances={LP.Character,part.Parent}; rp.IgnoreWater=true
    return workspace:Raycast(Camera.CFrame.Position,part.Position-Camera.CFrame.Position,rp)==nil
end

-- ═══════════════════════════════════════════════════════════
-- [10] DAHOOD UTILITY
-- ═══════════════════════════════════════════════════════════
local function dh_isKnocked(p)
    local char=p.Character; if not char then return false end
    if char:GetAttribute("Knocked") then return true end
    local be=char:FindFirstChild("BodyEffects")
    if be then
        for _,n in ipairs({"K.O","KO","Knocked"}) do
            local v=be:FindFirstChild(n); if v and v.Value then return true end
        end
    end
    local h=getHum(char); return h and h:GetState()==Enum.HumanoidStateType.Physics or false
end
local function dh_isDead(p)
    if not p.Character then return true end
    if p.Character:GetAttribute("Dead") then return true end
    local h=getHum(p.Character); return not h or h.Health<=0
end
local function dh_getArmor(p)
    if not p.Character then return 100 end
    for k,v in pairs(p.Character:GetAttributes()) do
        if string.lower(k):find("armor") then return v end
    end
    local be=p.Character:FindFirstChild("BodyEffects")
    if be then local a=be:FindFirstChild("Armor"); if a and a:IsA("NumberValue") then return a.Value end end
    return 100
end
local function dh_isGrabbed(p)
    return p.Character and p.Character:FindFirstChild("GRABBING_CONSTRAINT")~=nil
end

-- ═══════════════════════════════════════════════════════════
-- [11] AVENIR MOD DETECTOR
-- ═══════════════════════════════════════════════════════════
local ModData = {}
local function modIsMod(p)
    local ok,r=pcall(function() return p:IsInGroup(693335996) end); return ok and r
end
local function modGetRole(p)
    local ok,r=pcall(function() return p:GetRoleInGroup(693335996) end); return ok and r or "Staff"
end
if Flags.ModDetect and IS_DAHOOD then
    task.spawn(function()
        task.wait(2)
        local found={}
        for _,p in ipairs(Players:GetPlayers()) do
            if p==LP then continue end
            if modIsMod(p) then
                local role=modGetRole(p)
                ModData[p.UserId]={name=p.Name,role=role}
                table.insert(found,p.Name.." ("..role..")")
            end
        end
        if #found>0 then cWarn("STAFF DETECTED: "..table.concat(found,", "))
        else cOk("[ANTI-MOD] Server clean") end
    end)
    Players.PlayerAdded:Connect(function(p)
        task.wait(1)
        if Flags.ModDetect and IS_DAHOOD and modIsMod(p) then
            cWarn("STAFF JOINED: "..p.Name.." ("..modGetRole(p)..")")
        end
    end)
end

