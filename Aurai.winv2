local TabCol=Window:CreateTab({name="Colors",icon=93364949241311})
TabCol:CreateSection({name="ESP"})
for _,cd in ipairs({{"Enemy","ColEnemy"},{"Team","ColTeam"},{"Target","ColTarget"},
    {"Tracer","ColTracer"},{"FOV","ColFOV"},{"FOV Outer Ring","ColFOVOuter"},
    {"Radar","ColRadar"},{"Skeleton","ColSkeleton"},{"Health Bar","ColHealthBar"}}) do
    TabCol:CreateColorPicker({name=cd[1],flag=cd[2],color=hex(Flags[cd[2]]),callback=function(c) Flags[cd[2]]=toHex(c) end})
end
TabCol:CreateSection({name="Chams"})
TabCol:CreateColorPicker({name="SB Chams Visible",flag="ColChamsVis",color=hex(Flags.ColChamsVis),callback=function(c) Flags.ColChamsVis=toHex(c); for p in pairs(chamsStore) do clearChams(p) end end})
TabCol:CreateColorPicker({name="SB Chams Wall",flag="ColChamsWall",color=hex(Flags.ColChamsWall),callback=function(c) Flags.ColChamsWall=toHex(c); for p in pairs(chamsStore) do clearChams(p) end end})
TabCol:CreateColorPicker({name="HL Chams Fill",flag="ColHLFill",color=hex(Flags.ColHLFill),callback=function(c) Flags.ColHLFill=toHex(c); for _,hl in pairs(hlStore) do hl.FillColor=c end end})
TabCol:CreateColorPicker({name="HL Chams Outline",flag="ColHLOutline",color=hex(Flags.ColHLOutline),callback=function(c) Flags.ColHLOutline=toHex(c); for _,hl in pairs(hlStore) do hl.OutlineColor=c end end})
TabCol:CreateSection({name="Effects"})
TabCol:CreateColorPicker({name="Hit Marker",flag="ColHitMark",color=hex(Flags.ColHitMark),callback=function(c) Flags.ColHitMark=toHex(c) end})
TabCol:CreateColorPicker({name="Crosshair",flag="ColCrosshair",color=hex(Flags.ColCrosshair),callback=function(c) Flags.ColCrosshair=toHex(c) end})
TabCol:CreateColorPicker({name="Bullet Tracer Start",flag="ColBulletStart",color=hex(Flags.ColBulletStart),callback=function(c) Flags.ColBulletStart=toHex(c) end})
TabCol:CreateColorPicker({name="Bullet Tracer End",flag="ColBulletEnd",color=hex(Flags.ColBulletEnd),callback=function(c) Flags.ColBulletEnd=toHex(c) end})
TabCol:CreateColorPicker({name="Wings",flag="ColWings",color=hex(Flags.ColWings),callback=function(c) Flags.ColWings=toHex(c) end})
