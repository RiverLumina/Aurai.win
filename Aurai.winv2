TabDH:CreateSlider({name="KnockStomp Range",flag="KnockStompRange",currentValue=Flags.KnockStompRange,minValue=5,maxValue=200,decimals=0,suffix=" studs",callback=function(v) Flags.KnockStompRange=v end})
TabDH:CreateSection({name="Ethereal Sky-Dive Resolver"})
TabDH:CreateToggle({name="Eth Resolver Enable",flag="EthResolverEnable",currentValue=Flags.EthResolverEnable,callback=function(v) Flags.EthResolverEnable=v end})
TabDH:CreateToggle({name="Auto Stomp on KO",flag="EthResolverStomp",currentValue=Flags.EthResolverStomp,callback=function(v) Flags.EthResolverStomp=v end})
TabDH:CreateToggle({name="Rainbow Tracer",flag="EthTracerRainbow",currentValue=Flags.EthTracerRainbow,callback=function(v) Flags.EthTracerRainbow=v end})
TabDH:CreateSlider({name="Tracer Thickness",flag="EthTracerThick",currentValue=Flags.EthTracerThick,minValue=0.01,maxValue=0.5,decimals=2,callback=function(v) Flags.EthTracerThick=v end})
TabDH:CreateButton({name="Set Eth Target -> Closest in FOV",callback=function()
    local best,bd=nil,math.huge; local center=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP or not p.Character then continue end
        local hrp2=getRoot(p.Character); if not hrp2 then continue end
        local sp,on=Camera:WorldToViewportPoint(hrp2.Position); if not on then continue end
        local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude; if d<bd then bd=d; best=p end
    end
    if best then EthResolver.Target=best; cOk("Eth target -> "..best.Name)
        Window:Notify({title="Eth Resolver",content="Target: "..best.Name,duration=2})
    else cWarn("No target found") end
end})
TabDH:CreateButton({name="Start / Stop Eth Resolver",callback=function()
    if Flags.EthResolverEnable then startEthResolver()
    else cWarn("Enable Eth Resolver first") end
end})
TabDH:CreateSection({name="Auto Buy"})
TabDH:CreateToggle({name="Auto Buy on Spawn",flag="AutoBuy",currentValue=Flags.AutoBuy,callback=function(v) Flags.AutoBuy=v end})
TabDH:CreateSlider({name="Armor Threshold",flag="AutoBuyArmor",currentValue=Flags.AutoBuyArmor,minValue=0,maxValue=100,decimals=0,suffix="%",callback=function(v) Flags.AutoBuyArmor=v end})
