    end
end

local function startEthResolver()
    if ETH.Active then
        ETH.Active=false
        for _, c in ipairs(ETH.Connections) do c:Disconnect() end; ETH.Connections={}
        ethSetVoid(false)
        pcall(function() if ETH.State.beam then ETH.State.beam:Destroy() end end)
        pcall(function() if ETH.State.a0 then ETH.State.a0:Destroy() end end)
        pcall(function() if ETH.State.a1 then ETH.State.a1:Destroy() end end)
        ETH.State.beam=nil; ETH.State.a0=nil; ETH.State.a1=nil
        cOk("Eth Resolver stopped"); return
    end
    if not ETH.Target then cWarn("Set Eth target first"); return end
    ETH.Active=true; ETH.StompEnabled=Flags.EthResolverStomp
    ETH.State={
        attached=false,stomping=false,skyDiveActive=false,voidFrozen=false,storedProps={},
        lastStompSpam=0,positionSwitchTimer=0,currentOffsetDir=Vector3.new(0,0,-1),
        beam=nil,a0=nil,a1=nil,hue=0,
