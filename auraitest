local crosshairAngle   = 0
local crosshairLen     = 10
local crosshairGrowDir = 1
local crosshairLines   = {}

local function updateCrosshair()
    for _, l in pairs(crosshairLines) do safeRemove(l) end; crosshairLines={}
    if not Flags.CrosshairEnable or not HAS_DRAWING then return end
    local cx, cy
    if Flags.CrosshairSticky then
        local ml = UserInputService:GetMouseLocation(); cx=ml.X; cy=ml.Y
    else cx=Camera.ViewportSize.X/2; cy=Camera.ViewportSize.Y/2 end
    local n = math.max(1, Flags.CrosshairLines)
    local step = 360/n; local col=fc("ColCrosshair")
    local len = crosshairLen; local r = Flags.CrosshairRadius
    for i = 0, n-1 do
        local ang = math.rad(crosshairAngle+step*i)
        local sx = cx+math.cos(ang)*r; local sy = cy+math.sin(ang)*r
        local ex = cx+math.cos(ang)*(r+len); local ey = cy+math.sin(ang)*(r+len)
        local l = mkLine(sx,sy,ex,ey,col,Flags.CrosshairWidth)
        if l then table.insert(crosshairLines,l) end
    end
end

