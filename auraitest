-- [48] AIMBOT LOOP
-- ═══════════════════════════════════════════════════════════
RunService.Heartbeat:Connect(function()
    -- SpinBot
    if Flags.SpinBot then
        local char = LP.Character; local hrp = char and getRoot(char)
        if hrp then hrp.CFrame=hrp.CFrame*CFrame.fromEulerAnglesXYZ(0,math.rad(Flags.SpinSpeed),0) end
    end

    -- DaHood Force Hit
    if IS_DAHOOD and DH_Remote and Flags.DH_FH then
        local best, bd = nil, math.huge
        local mousePos = UserInputService:GetMouseLocation()
        for _, p in ipairs(Players:GetPlayers()) do
            if p==LP or not dh_shouldTarget(p) then continue end
            local char = p.Character; if not char then continue end
            local tp = char:FindFirstChild(Flags.DH_FHHitPart) or char:FindFirstChild("Head"); if not tp then continue end
            local sp, inV = Camera:WorldToViewportPoint(tp.Position)
            if inV then
                local dist = (Vector2.new(sp.X,sp.Y)-mousePos).Magnitude
                if dist < bd then bd=dist; best=p end
            end
        end
        if best then dh_fire(best) end
    end

    -- DaHood Auto Stomp
    if IS_DAHOOD and DH_Remote and Flags.DH_AutoStomp then
        for _, p in ipairs(Players:GetPlayers()) do
            if p==LP then continue end
            if dh_isKnocked(p) and not dh_isDead(p) then
                local char = p.Character; if not char then continue end
                local hrp2 = getRoot(char); if not hrp2 then continue end
                local myHRP = LP.Character and getRoot(LP.Character); if not myHRP then continue end
                if (myHRP.Position-hrp2.Position).Magnitude < 15 then
                    pcall(function() DH_Remote:FireServer("Stomp") end)
                end
            end
        end
    end

    -- Aimbot
    if not Flags.AimEnable or not Aiming then
        if AimTween then AimTween:Cancel(); AimTween=nil end
        UserInputService.MouseDeltaSensitivity=SavedMouseSens
        return
    end

    -- Find target
    if not isReady(Target) then
        local closest = math.huge; Target=nil
        local mousePos = UserInputService:GetMouseLocation()
        for _, p in ipairs(Players:GetPlayers()) do
            if p==LP then continue end
            local char = p.Character; if not char then continue end
            local ok,_,vpPos = isReady(char)
            if ok and vpPos then
                local dist = (vpPos-mousePos).Magnitude
                if dist < closest then closest=dist; Target=char end
            end
        end
    end

    local ok,_,vpPos,worldPos,_,predVP = isReady(Target)
    if not ok then resetAimbot(false); return end

    local mode = Flags.AimMode
    if mode=="Camera" then
        UserInputService.MouseDeltaSensitivity=0
        if Flags.AimSmooth then
            if AimTween then AimTween:Cancel() end
            AimTween=TweenService:Create(Camera,
                TweenInfo.new(math.clamp(Flags.AimSmoothVal,1,99)/100,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),
                {CFrame=CFrame.new(Camera.CFrame.Position,worldPos)})
            AimTween:Play()
        else
            Camera.CFrame=CFrame.new(Camera.CFrame.Position,worldPos)
        end
    elseif mode=="Mouse" and HAS_MOUSEMOVE then
        if AimTween then AimTween:Cancel(); AimTween=nil end
        UserInputService.MouseDeltaSensitivity=SavedMouseSens
        local mp = UserInputService:GetMouseLocation()
        local tx = predVP and predVP.X or vpPos.X; local ty = predVP and predVP.Y or vpPos.Y
        local sens = Flags.AimSmooth and math.clamp(Flags.AimSmoothVal,1,99)/10 or 1
        mousemoverel((tx-mp.X)/sens,(ty-mp.Y)/sens)
    elseif mode=="Silent" and HAS_HOOKMETHOD then
        UserInputService.MouseDeltaSensitivity=SavedMouseSens
    end
end)

