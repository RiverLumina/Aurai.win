local CSyncTarget = nil

local function getCSyncFrame()
    if not (Flags.CSyncEnable and CSyncTarget and CSyncTarget.Character) then return nil end
    local tHRP = CSyncTarget.Character:FindFirstChild("HumanoidRootPart"); if not tHRP then return nil end
    local tPos = tHRP.Position; local t = tick()
    local typ  = Flags.CSyncType
    if typ=="Orbit" then
        return CFrame.new(tPos)
             * CFrame.Angles(0,2*math.pi*t*Flags.CSyncSpeed%(2*math.pi),0)
             * CFrame.new(0,Flags.CSyncHeight,Flags.CSyncDistance)
    elseif typ=="Spiral" then
        local ang = 2*math.pi*t*Flags.CSyncSpeed%(2*math.pi)
        local r   = Flags.CSyncDistance + math.sin(t)*Flags.CSyncRandom
        return CFrame.new(tPos)*CFrame.Angles(0,ang,0)*CFrame.new(r,Flags.CSyncHeight,0)
    elseif typ=="Random" then
        local rr = Flags.CSyncRandom
        return CFrame.new(tPos+Vector3.new(math.random(-rr,rr),math.random(0,rr),math.random(-rr,rr)))
    elseif typ=="Attach" then
        return CFrame.new(tHRP.Position + tHRP.AssemblyLinearVelocity*0.1)
    end
    return CFrame.new(tPos)
end

local function doCSSync()
    if not Flags.CSyncEnable or not CSyncTarget then return end
    local myChar = LP.Character
    if not (myChar and myChar:FindFirstChild("HumanoidRootPart")) then return end
    local myHRP = myChar.HumanoidRootPart
    local cf    = getCSyncFrame(); if not cf then return end
    pcall(function()
        if HAS_SETHIDDEN then sethiddenproperty(myHRP,"NetworkOwnership",LP) end
        myHRP.CFrame = cf
        myHRP.AssemblyLinearVelocity  = Vector3.zero
        myHRP.AssemblyAngularVelocity = Vector3.zero
    end)
end

