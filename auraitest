                    elseif self==workspace and (method=="Raycast" or method=="raycast")
                        and typeof(args[2])=="Vector3" and typeof(args[3])=="Vector3" then
                        if (args[2]-Camera.CFrame.Position).Magnitude < 8 then
                            args[3] = worldPos - args[2]
                            return oldNameCall(table.unpack(args))
                        end
                    end
                end
            end
            -- Bullet tracers: hook FireServer on shoot remotes
            if Flags.BulletTracers and method=="FireServer" then
                local evName = ""
                pcall(function() evName = self.Name end)
                if evName=="MainEvent" or evName=="MAINEVENT" then
                    local arg = args[2]
                    if arg=="ShootGun" or arg=="Shoot" or arg=="SHOOT" then
                        local myChar = LP.Character
