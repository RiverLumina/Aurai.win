-- [46] MAIN HEARTBEAT
-- ═══════════════════════════════════════════════════════════
RunService.Heartbeat:Connect(function(dt)
    -- WalkSpeed
    if Flags.WalkSpeed then
        local char = LP.Character; local hum = char and getHum(char)
        if hum then hum.WalkSpeed=Flags.WalkSpeedVal end
    end

    -- CFrame Fly
    if Flags.CFrameFlyEnable then
        local char = LP.Character; local hrp = char and getRoot(char); local hum = char and getHum(char)
        if hrp and hum then
            hrp.AssemblyLinearVelocity=Vector3.zero
            local mv=Vector3.zero; local cam=Camera.CFrame
            if not UserInputService:GetFocusedTextBox() then
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv=mv+cam.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv=mv-cam.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv=mv-cam.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv=mv+cam.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv=mv+Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then mv=mv-Vector3.new(0,1,0) end
            end
            if mv.Magnitude>0 then
                local speed=Flags.CFrameFlySpeed/10*(dt*60)
                hrp.CFrame=hrp.CFrame+mv.Unit*speed
            end
        end
    end

    antiVoidSimple(); antiVoidV2()

    -- Anti-Aim
    if Flags.AntiAim then
        local char = LP.Character; local hrp = char and getRoot(char)
        if hrp then
