RunService.RenderStepped:Connect(function(dt)
    -- Glow / Chams
    for _, p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        if Flags.ESPGlow then
            local isT = (Target and Players:GetPlayerFromCharacter(Target)==p)
                     or (clActive and clTarget and Players:GetPlayerFromCharacter(clTarget.Parent)==p)
            local col = isEnemy(p) and fc("ColEnemy") or fc("ColTeam"); if isT then col=fc("ColTarget") end
            applyGlow(p, col)
        else clearGlow(p) end
        if Flags.ChamsEnable then applyChams(p) else clearChams(p) end
    end
    tickChams(); tickHL()

    -- HitMarker fade
    local now = tick()
    for i = #hitMarkers,1,-1 do
        local hm = hitMarkers[i]; local age=now-hm.t
        if age>0.22 then
            for _, l in ipairs(hm.lines) do safeRemove(l) end; table.remove(hitMarkers,i)
        else
            local a = 1-age/0.22; for _, l in ipairs(hm.lines) do l.Transparency=1-a end
        end
    end

    updateFovCircle()
    doCamLock()
    applyWorldVisuals()

    -- Wings / Aura
    local myChar = LP.Character
    if myChar then
        if Flags.WingsEnable then
            applyWings(myChar)
            if Flags.WingsPulse then
                local emits = WingEmitters[myChar]
                if emits then
                    local pulse = math.abs(math.sin(tick()*Flags.WingsPulseSpeed))
                    for _, e in ipairs(emits) do pcall(function() e.Rate=math.floor(pulse*12)+1 end) end
                end
            end
        else clearWings(myChar) end
        if Flags.AuraEnable then applyAura(myChar) else clearAura(myChar) end
    end

    -- ESP Drawing
    if Flags.ESPEnable and HAS_DRAWING then
        for _, p in ipairs(Players:GetPlayers()) do
            if p==LP then continue end
            clearEspPlayer(p)
            local char = p.Character; if not char then continue end
            local hum  = getHum(char); if not hum or hum.Health<=0 then continue end
            local hrp  = getRoot(char); if not hrp then continue end
            local head = char:FindFirstChild("Head") or hrp
            local hrpVP, inV, depth = Camera:WorldToViewportPoint(hrp.Position)
            if not inV or depth < 0 then continue end
            local topVP    = Camera:WorldToViewportPoint(head.Position+Vector3.new(0,0.5,0))
            local bottomVP = Camera:WorldToViewportPoint(hrp.Position-Vector3.new(0,3,0))
            -- box sizing (like Open Aimbot: 2350/Z)
            local boxW = 2350 / math.max(hrpVP.Z, 1)
            local boxH = math.abs(topVP.Y-bottomVP.Y)
            local boxX = hrpVP.X-boxW/2; local boxY = topVP.Y
            -- colour
            local isT = (Target and Players:GetPlayerFromCharacter(Target)==p)
                     or (clActive and clTarget and Players:GetPlayerFromCharacter(clTarget.Parent)==p)
            local col
            if Flags.ESPTeamColour then
                local ok, tc = pcall(function() return p.TeamColor.Color end); col=ok and tc or fc("ColEnemy")
            else col = isEnemy(p) and fc("ColEnemy") or fc("ColTeam"); if isT then col=fc("ColTarget") end end
            local d = {}; espObjs[p]=d
            if Flags.ESPBox then d.box=mkSquare(boxX,boxY,boxW,boxH,col,Flags.ESPThickness,false) end
            if Flags.ESPName then
                local lbl = isT and ("[TARGET] "..p.Name) or ("@"..p.Name)
                d.name=mkTxt(lbl,hrpVP.X,boxY+boxH+2,col,13,true)
            end
            if Flags.ESPHealth then
                d.health=mkTxt(string.format("[%.0f%%]",hum.Health/hum.MaxHealth*100),hrpVP.X,boxY-14,col,12,true)
            end
            if Flags.ESPDistance then
                d.dist=mkTxt("["..math.floor((Camera.CFrame.Position-hrp.Position).Magnitude).."m]",hrpVP.X,hrpVP.Y+2,col,11,true)
            end
            if Flags.ESPTracer then
                d.tracer=mkLine(Camera.ViewportSize.X/2,Camera.ViewportSize.Y,hrpVP.X,boxY,fc("ColTracer"),Flags.ESPThickness)
            end
            if Flags.ESPHealthBar then
                local hpR=math.clamp(hum.Health/hum.MaxHealth,0,1); local barH=boxH*hpR
                local barX=boxX-5
                d.hpBg  = mkSquare(barX-1,boxY-1,4,boxH+2,Color3.new(0,0,0),1,true)
                d.hpBar = mkSquare(barX,boxY+boxH-barH,2,barH,fc("ColHealthBar"),1,true)
            end
            if Flags.ESPSkeleton then
                local isR15 = char:FindFirstChild("UpperTorso")~=nil
                local boneMap = isR15 and BONES_R15 or BONES_R6; d.skel={}
                for _, pair in ipairs(boneMap) do
                    local pa=char:FindFirstChild(pair[1]); local pb=char:FindFirstChild(pair[2])
                    if pa and pb then
                        local a2,aV=Camera:WorldToViewportPoint(pa.Position)
                        local b2,bV=Camera:WorldToViewportPoint(pb.Position)
                        if aV and bV then
                            local l=mkLine(a2.X,a2.Y,b2.X,b2.Y,fc("ColSkeleton"),Flags.ESPSkeletonThick)
                            if l then table.insert(d.skel,l) end
                        end
                    end
                end
            end
        end
    else clearAllEsp() end

    -- Radar
    if not Flags.RadarEnable then
        if radarGui then destroyRadar() end
    else
        if not radarGui then buildRadar() end
        local myHRP2 = LP.Character and getRoot(LP.Character)
        if myHRP2 then
            local myCF  = myHRP2.CFrame
            local myYaw = math.atan(myCF.LookVector.X,-myCF.LookVector.Z)
            for p, dot in pairs(radarDots) do
                if not Players:FindFirstChild(p.Name) then dot:Destroy(); radarDots[p]=nil end
            end
            for _, p in ipairs(Players:GetPlayers()) do
                if p==LP then continue end
                local char = p.Character; if not char then continue end
                local hrp2 = getRoot(char); if not hrp2 then continue end
                local hum2 = getHum(char)
                if not hum2 or hum2.Health<=0 then
                    if radarDots[p] then radarDots[p]:Destroy(); radarDots[p]=nil end; continue
                end
                local dotCol = isEnemy(p) and fc("ColRadar") or Color3.fromRGB(80,220,80)
                if not radarDots[p] then
                    local dot=Instance.new("Frame"); dot.Size=UDim2.new(0,7,0,7); dot.AnchorPoint=Vector2.new(0.5,0.5)
                    dot.BackgroundColor3=dotCol; dot.BorderSizePixel=0; dot.Parent=radarFrame
                    Instance.new("UICorner",dot).CornerRadius=UDim.new(1,0); radarDots[p]=dot
                end
                radarDots[p].BackgroundColor3=dotCol
                local delta=hrp2.Position-myHRP2.Position
                local cos=math.cos(-myYaw); local sin=math.sin(-myYaw)
                local rx=delta.X*cos-delta.Z*sin; local rz=delta.X*sin+delta.Z*cos
                radarDots[p].Position=UDim2.new(math.clamp(0.5+rx*0.08,0.05,0.95),0,math.clamp(0.5+rz*0.08,0.05,0.95),0)
            end
        end
    end
end)

