local function safeGet(url)
    local fns = {
        function() return (request or http and http.request or syn and syn.request)({Url=url,Method="GET"}).Body end,
        function() return game:HttpGet(url,true) end,
    }
    for _,fn in ipairs(fns) do
        local ok,r = pcall(fn)
        if ok and type(r)=="string" and #r>100 then return r end
    end
    return nil
end

local function tryLoad(url, label)
    local src = safeGet(url)
    if not src then warn("[Aurai] "..label.." fetch failed"); return nil end
    local chunk,err = loadstring(src)
    if not chunk then warn("[Aurai] "..label.." compile: "..tostring(err)); return nil end
    local ok,res = pcall(chunk)
    if not ok then warn("[Aurai] "..label.." runtime: "..tostring(res)); return nil end
    if type(res)=="table" then print("[Aurai] "..label.." ✓"); return res end
    if type(getgenv)=="function" and getgenv().Rayfield then return getgenv().Rayfield end
    warn("[Aurai] "..label.." no table returned"); return nil
end

