local function findShopItem(name)
    if ShopItemCache[name] then
        local c = ShopItemCache[name]
        if c.item and c.item.Parent and c.cd and c.cd.Parent then return c.item, c.cd end
        ShopItemCache[name] = nil
    end
    local plain = name:gsub("%[",""):gsub("%]","")
    for _, loc in ipairs(getShopLocations()) do
        for _, child in ipairs(loc:GetChildren()) do
            if child.Name==name or child.Name:find(plain,1,true) then
                local cd = child:FindFirstChildOfClass("ClickDetector")
