local ALL_PARTS = {
    "Head","UpperTorso","HumanoidRootPart","LowerTorso",
    "LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm","LeftHand","RightHand",
    "LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg","LeftFoot","RightFoot",
    "Torso","Left Arm","Right Arm","Left Leg","Right Leg",
}

local function getRoot(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChildOfClass("BasePart")
end

local function getHum(char)
    return char and char:FindFirstChildWhichIsA("Humanoid")
end

local function getAimPart(char, partName)
    if not char then return nil end
    local name = partName or Flags.AimPart
    if name == "Closest Part" then
        local best, bd = nil, math.huge
        local mp = UserInputService:GetMouseLocation()
        for _, n in ipairs(ALL_PARTS) do
            local p = char:FindFirstChild(n)
            if p then
                local sp, on = Camera:WorldToViewportPoint(p.Position)
                if on then
                    local d = (Vector2.new(sp.X,sp.Y)-mp).Magnitude
                    if d < bd then bd=d; best=p end
                end
            end
        end
        return best
    end
    local p = char:FindFirstChild(name)
    if p and p:IsA("BasePart") then return p end
    for _, fn in ipairs({"Head","HumanoidRootPart","UpperTorso","Torso"}) do
        local fp = char:FindFirstChild(fn)
        if fp and fp:IsA("BasePart") then return fp end
    end
    return char:FindFirstChildOfClass("BasePart")
end

local function isEnemy(p)
    if p == LP then return false end
    if not Flags.AimTeamCheck then return true end
    local ok, r = pcall(function() return p.TeamColor ~= LP.TeamColor end)
    return ok and r or true
end

local function isInAir(p)
    local char = p.Character; if not char then return false end
    local hum = getHum(char); if not hum then return false end
    local s = hum:GetState()
    return s==Enum.HumanoidStateType.Freefall or s==Enum.HumanoidStateType.Jumping
end

local function canSee(part)
    if not part then return false end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LP.Character or {}, part.Parent or {}}
    rp.IgnoreWater = true
    return workspace:Raycast(Camera.CFrame.Position, part.Position-Camera.CFrame.Position, rp) == nil
end

