-- [13] PREDICTION
-- ═══════════════════════════════════════════════════════════
local function getPredictedPos(p, part)
    if not Flags.PredEnable or not part then return part and part.Position or Vector3.zero end
    local vel = Flags.ResolverEnable and resolverGet(p, Flags.ResolverMethod)
                                      or part.AssemblyLinearVelocity
    if not Flags.PredVertical then vel = Vector3.new(vel.X,0,vel.Z) end
    local lead = vel * Flags.PredVal
    local maxLead = Flags.PredMaxLead or 15
    if lead.Magnitude > maxLead then lead = lead.Unit * maxLead end
    if isInAir(p) and vel.Y < 0 then lead = Vector3.new(lead.X,0,lead.Z) end
    return part.Position + lead
end

