local clActive, clTarget, clLastVisible = false, nil, nil

local function elasticOut(t)
    local p = 0.3
    return math.pow(2,-10*t)*math.sin((t-p/4)*(2*math.pi)/p)+1
end
local function sineInOut(t) return -(math.cos(math.pi*t)-1)/2 end

local function findCLTarget()
    local best, bd = nil, math.huge
    local mp = UserInputService:GetMouseLocation()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local char = p.Character; if not char then continue end
        if Flags.CamLockTeam and p.Team == LP.Team then continue end
        if Flags.CamLockKnock and dh_isKnocked(p) then continue end
        if Flags.CamLockDead  and dh_isDead(p)     then continue end
        local part = getAimPart(char, Flags.CamLockPart); if not part then continue end
        local sp, on = Camera:WorldToViewportPoint(part.Position); if not on then continue end
        local d = (Vector2.new(sp.X,sp.Y)-mp).Magnitude
        if d >= bd then continue end
        if Flags.CamLockWall and not canSee(part) then continue end
        bd=d; best=part
    end
    return best
end

local function doCamLock()
    if not Flags.CamLockEnable or not clActive then return end
    if not clTarget or not clTarget.Parent then
        clActive=false; clTarget=nil; clLastVisible=nil; return
    end
    local p = Players:GetPlayerFromCharacter(clTarget.Parent)
    if not p then clActive=false; clTarget=nil; clLastVisible=nil; return end
    if Flags.CamLockDead  and dh_isDead(p)     then clActive=false; clTarget=nil; return end
    if Flags.CamLockKnock and dh_isKnocked(p)  then clActive=false; clTarget=nil; return end
    local fresh = getAimPart(clTarget.Parent, Flags.CamLockPart)
    if fresh and fresh.Parent then clTarget = fresh end
    if Flags.CamLockWall and not canSee(clTarget) then
        if clLastVisible and clLastVisible.Parent then clTarget = clLastVisible end
        return
    end
    clLastVisible = clTarget
    local vel = clTarget.AssemblyLinearVelocity
    local tPos = clTarget.Position + Vector3.new(vel.X*Flags.PredVal, vel.Y*Flags.PredVal, 0)
    local cur = Camera.CFrame; local tgt = CFrame.new(cur.Position, tPos)
    local aX = math.clamp(Flags.CamLockSmX,0.001,1)
    local aY = math.clamp(Flags.CamLockSmY,0.001,1)
    local avg = (aX+aY)*0.5
    local eaX = elasticOut(aX); local eaY = elasticOut(aY)
    local cL = cur.LookVector; local tL = tgt.LookVector
    local dir = Vector3.new(
        cL.X+(tL.X-cL.X)*(eaX*aX),
        cL.Y+(tL.Y-cL.Y)*(eaY*aY),
        cL.Z+(tL.Z-cL.Z)*(eaX*aX)
    )
    if dir.Magnitude <= 0 then return end
    local smoothCF = CFrame.new(cur.Position, cur.Position+dir.Unit)
    Camera.CFrame = smoothCF:Lerp(tgt, sineInOut(math.min(avg,1))*avg)
end

