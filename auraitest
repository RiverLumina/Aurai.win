btn(TR,"Set CSync Target (Closest)",function()
    local best,bd=nil,math.huge; local center=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP or not p.Character then continue end
        local hrp2=getRoot(p.Character); if not hrp2 then continue end
        local sp,on=Camera:WorldToViewportPoint(hrp2.Position); if not on then continue end
        local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude; if d<bd then bd=d; best=p end
    end
    if best then CSyncTarget=best; cOk("CSync target -> "..best.Name)
        Window:Notify({title="CSync",content="Target: "..best.Name,duration=2})
    end
end)
