local ETH = {
    Active=false, Target=nil, StompEnabled=true, Connections={},
    State={
        attached=false, stomping=false, skyDiveActive=false, voidFrozen=false,
        storedProps={}, lastStompSpam=0, positionSwitchTimer=0,
        currentOffsetDir=Vector3.new(0,0,-1), beam=nil, a0=nil, a1=nil, hue=0,
    }
}
local ETH_CFG = {
    SKY_TIME=0.1, GROUND_TIME=0.1, POSITION_SWITCH_INTERVAL=0.1,
    STOMP_HEIGHT=4, STOMP_SPAM_COUNT=12, STOMP_SPAM_INTERVAL=0.03,
    VOID_HEIGHT=50000, OFFSET_DISTANCE=3,
}

local function ethSetVoid(enable)
    local char = LP.Character; if not char then return end
    if enable then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name~="HumanoidRootPart" then
                ETH.State.storedProps[part] = {CanCollide=part.CanCollide,Transparency=part.Transparency}
                part.CanCollide=false; part.Transparency=1
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.MaxHealth=math.huge; hum.Health=hum.MaxHealth; hum.PlatformStand=true end
    else
        for part, props in pairs(ETH.State.storedProps) do
            if part and part.Parent then
                part.CanCollide=props.CanCollide; part.Transparency=props.Transparency
            end
        end
        ETH.State.storedProps = {}
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.MaxHealth=100; hum.PlatformStand=false end
    end
end

local function ethRandomDir()
    local a = math.random()*6.283
    return Vector3.new(math.cos(a),0,math.sin(a))
end

local function ethSkyDiveLoop()
    while ETH.Active and ETH.State.skyDiveActive do
        if ETH.State.stomping then ETH.State.skyDiveActive=false; break end
        if not (ETH.Target and ETH.Target.Character) then ETH.State.skyDiveActive=false; break end
        local char = LP.Character; if not char then break end
        local hrp  = char:FindFirstChild("HumanoidRootPart"); if not hrp then break end
        ETH.State.attached = false
        local voidCF = CFrame.new(hrp.Position.X, ETH_CFG.VOID_HEIGHT, hrp.Position.Z)
        hrp.CFrame = voidCF; hrp.AssemblyLinearVelocity=Vector3.zero; hrp.AssemblyAngularVelocity=Vector3.zero
        ethSetVoid(true)
        local s = tick()
        while tick()-s<ETH_CFG.SKY_TIME and ETH.Active and ETH.State.skyDiveActive and not ETH.State.stomping do
            hrp.CFrame=voidCF; hrp.AssemblyLinearVelocity=Vector3.zero; hrp.AssemblyAngularVelocity=Vector3.zero
            local hum = char:FindFirstChildOfClass("Humanoid"); if hum then hum.Health=hum.MaxHealth end
            RunService.Heartbeat:Wait()
        end
        ethSetVoid(false)
        local tHRP = ETH.Target.Character:FindFirstChild("HumanoidRootPart")
        if tHRP and ETH.Active and ETH.State.skyDiveActive and not ETH.State.stomping then
            ETH.State.attached=true; ETH.State.currentOffsetDir=ethRandomDir()
            local offsetPos = tHRP.Position + ETH.State.currentOffsetDir*ETH_CFG.OFFSET_DISTANCE
            hrp.CFrame = CFrame.lookAt(offsetPos, tHRP.Position)
            task.wait(ETH_CFG.GROUND_TIME)
        else ETH.State.skyDiveActive=false end
    end
    ethSetVoid(false); ETH.State.attached=false
end

local function ethHeartbeat(dt)
    if not ETH.Active or not ETH.Target then return end
    local char = LP.Character; if not char then return end
    local hrp  = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    if ETH.State.voidFrozen then
        local vCF = CFrame.new(hrp.Position.X,ETH_CFG.VOID_HEIGHT,hrp.Position.Z)
        hrp.CFrame=vCF; hrp.AssemblyLinearVelocity=Vector3.zero; return
    end
    local tChar = ETH.Target.Character; if not tChar then return end
    local be    = tChar:FindFirstChild("BodyEffects")
    local isKO  = be and be:FindFirstChild("K.O") and be["K.O"].Value
    local isDead = be and be:FindFirstChild("Dead") and be["Dead"].Value
    if isKO and not isDead and ETH.StompEnabled and not ETH.State.stomping then
        ETH.State.stomping=true; ETH.State.attached=false; ETH.State.skyDiveActive=false; ethSetVoid(false)
    end
    if ETH.State.stomping then
        pcall(function() if HAS_SETHIDDEN then sethiddenproperty(hrp,"NetworkOwnership",LP) end end)
        local top = tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso") or tChar:FindFirstChild("HumanoidRootPart")
        if top then
            hrp.CFrame=CFrame.new(top.Position+Vector3.new(0,ETH_CFG.STOMP_HEIGHT,0))
            hrp.AssemblyLinearVelocity=Vector3.zero; hrp.AssemblyAngularVelocity=Vector3.zero
            if tick()-ETH.State.lastStompSpam > ETH_CFG.STOMP_SPAM_INTERVAL then
                for _ = 1, ETH_CFG.STOMP_SPAM_COUNT do
                    pcall(function()
                        local ev = ReplicatedStorage:FindFirstChild("MainEvent")
                        if ev and ev:IsA("RemoteEvent") then ev:FireServer("Stomp") end
                    end)
                end
                ETH.State.lastStompSpam = tick()
            end
        end
        if isDead then
            ETH.State.stomping=false; ETH.State.voidFrozen=true; ethSetVoid(true)
            hrp.CFrame=CFrame.new(hrp.Position.X,ETH_CFG.VOID_HEIGHT,hrp.Position.Z)
            hrp.AssemblyLinearVelocity=Vector3.zero
        end
        return
    end
    if ETH.State.attached then
        local tHRP = tChar:FindFirstChild("HumanoidRootPart"); if not tHRP then ETH.State.attached=false; return end
        pcall(function()
            if HAS_SETHIDDEN then sethiddenproperty(hrp,"NetworkOwnership",LP) end
            ETH.State.positionSwitchTimer = ETH.State.positionSwitchTimer + dt
            if ETH.State.positionSwitchTimer >= ETH_CFG.POSITION_SWITCH_INTERVAL then
                ETH.State.positionSwitchTimer=0; ETH.State.currentOffsetDir=ethRandomDir()
            end
            local offsetPos = tHRP.Position + ETH.State.currentOffsetDir*ETH_CFG.OFFSET_DISTANCE
            hrp.CFrame = CFrame.lookAt(offsetPos, tHRP.Position)
            hrp.AssemblyLinearVelocity=Vector3.zero; hrp.AssemblyAngularVelocity=Vector3.zero
        end)
        if isDead and not ETH.State.voidFrozen then
            ETH.State.attached=false; ETH.State.stomping=false; ETH.State.voidFrozen=true; ethSetVoid(true)
            hrp.CFrame=CFrame.new(hrp.Position.X,ETH_CFG.VOID_HEIGHT,hrp.Position.Z)
            hrp.AssemblyLinearVelocity=Vector3.zero
        end
    end
end

local function ethRender(dt)
    if not ETH.Active or not ETH.Target then
        if ETH.State.beam then pcall(function() ETH.State.beam.Enabled=false end) end; return
    end
    local tHRP = ETH.Target.Character and ETH.Target.Character:FindFirstChild("HumanoidRootPart")
    if tHRP then
        if not ETH.State.beam then
            pcall(function()
                ETH.State.a0 = Instance.new("Attachment",workspace.Terrain)
