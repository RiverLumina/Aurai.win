-- [14] TARGET VALIDATION
-- Returns: ok, char, vpPos(V2), worldPos(V3), aimPart, predVP(V2)
-- ═══════════════════════════════════════════════════════════
local function isReady(char)
    if not char then return false end
    local p = Players:GetPlayerFromCharacter(char)
    if not p or p == LP then return false end
    local hum = getHum(char); if not hum then return false end
    local aimPart = getAimPart(char); if not aimPart then return false end
    local myChar = LP.Character; if not myChar then return false end
    local myRoot = getRoot(myChar); if not myRoot then return false end
    if Flags.AimAliveCheck and hum.Health <= 0 then return false end
    if hum.Health >= 10^36 or myChar:FindFirstChildOfClass("ForceField") then return false end
    if Flags.AimTeamCheck then
        local ok, same = pcall(function() return p.TeamColor == LP.TeamColor end)
        if ok and same then return false end
    end
    if Flags.AimWallCheck then
        local dir = aimPart.Position - myRoot.Position
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = {myChar}
        local result = workspace:Raycast(myRoot.Position, dir, rp)
        if not result or not result.Instance then return false end
        if not result.Instance:FindFirstAncestor(p.Name) then return false end
    end
    local vpPos, inV = Camera:WorldToViewportPoint(aimPart.Position)
    if not inV then return false end
    local vp2 = Vector2.new(vpPos.X, vpPos.Y)
    if Flags.AimFOVCheck then
        local mp = UserInputService:GetMouseLocation()
        if (vp2-mp).Magnitude > Flags.AimFOV then return false end
    end
    local worldPos  = getPredictedPos(p, aimPart)
    local predVPRaw = Camera:WorldToViewportPoint(worldPos)
    return true, char, vp2, worldPos, aimPart, Vector2.new(predVPRaw.X, predVPRaw.Y)
end

