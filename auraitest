local strafeAngle = 0; local strafeLastTick = tick()
local StrafeShapes = {
    Normal     = function(a,d,h) return Vector3.new(math.cos(a)*d,h,math.sin(a)*d) end,
    Elliptical = function(a,d,h) return Vector3.new(math.cos(a)*d,h+math.sin(a*2)*2,math.sin(a)*d*0.6) end,
    Star       = function(a,d,h) local r=d*(1+0.5*math.cos(5*a)); return Vector3.new(r*math.cos(a),h,r*math.sin(a)) end,
    Infinity   = function(a,d,h) local k=d/2; local k2=1+math.pow(math.sin(a),2)
                     return Vector3.new(k*math.cos(a)/k2*2,h,k*math.sin(a)*math.cos(a)/k2*2) end,
    Helix      = function(a,d,h) return Vector3.new(d*math.cos(a),h+math.sin(a*2)*3,d*math.sin(a)) end,
    Rose       = function(a,d,h) local r=d*math.cos(4*a); return Vector3.new(r*math.cos(a),h,r*math.sin(a)) end,
}

local function doTargetStrafe()
    if not Flags.StrafeEnable then return end
    local tPlayer = (clActive and clTarget and Players:GetPlayerFromCharacter(clTarget.Parent))
                 or (Target and Players:GetPlayerFromCharacter(Target))
    if not (tPlayer and tPlayer.Character and tPlayer.Character:FindFirstChild("HumanoidRootPart")) then return end
    local myChar = LP.Character
    if not (myChar and myChar:FindFirstChild("HumanoidRootPart")) then return end
    local myHRP = myChar.HumanoidRootPart
    local tHRP  = tPlayer.Character.HumanoidRootPart
    local now = tick(); local dt = now-strafeLastTick; strafeLastTick=now
    strafeAngle = strafeAngle + dt*Flags.StrafeSpeed
    local shapeFn = StrafeShapes[Flags.StrafePattern] or StrafeShapes.Normal
    local offset  = shapeFn(strafeAngle, Flags.StrafeDistance, Flags.StrafeHeight)
    local newCF   = CFrame.new(tHRP.Position+offset, tHRP.Position)
    myHRP.CFrame                   = newCF
    myHRP.AssemblyLinearVelocity   = Vector3.zero
    myHRP.AssemblyAngularVelocity  = Vector3.zero
end

