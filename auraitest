local function CreateTracerBeam(startPos, endPos)
    pcall(function()
        local mp = Instance.new("Part")
        mp.Parent=workspace; mp.Size=Vector3.zero; mp.Transparency=1
        mp.CanCollide=false; mp.Anchored=true; mp.Position=startPos
        local p0 = Instance.new("Part"); p0.Parent=mp; p0.Size=Vector3.zero
        p0.Transparency=1; p0.CanCollide=false; p0.Anchored=true; p0.Position=startPos
        local p1 = Instance.new("Part"); p1.Parent=mp; p1.Size=Vector3.zero
        p1.Transparency=1; p1.CanCollide=false; p1.Anchored=true; p1.Position=endPos
        local a0 = Instance.new("Attachment"); a0.Parent=p0
        local a1 = Instance.new("Attachment"); a1.Parent=p1
        local beam = Instance.new("Beam"); beam.Parent=mp
        beam.Texture="rbxassetid://446111271"
        beam.TextureMode=Enum.TextureMode.Wrap; beam.TextureLength=10
        beam.LightEmission=1; beam.FaceCamera=true
        beam.Color=ColorSequence.new({
            ColorSequenceKeypoint.new(0, fc("ColBulletStart")),
            ColorSequenceKeypoint.new(1, fc("ColBulletEnd")),
        })
        beam.Attachment0=a0; beam.Attachment1=a1
        beam.Width0=Flags.BulletWidth; beam.Width1=Flags.BulletWidth; beam.Enabled=true
        if Flags.BulletFade then
            local total = 0
            local conn; conn = RunService.Heartbeat:Connect(function(dt)
                total=total+dt
                local prog=math.min(total/Flags.BulletDuration,1)
                beam.Transparency=NumberSequence.new(prog)
                if prog>=1 then conn:Disconnect() end
            end)
        end
        task.delay(Flags.BulletDuration, function() pcall(function() mp:Destroy() end) end)
    end)
end

if HAS_HOOKMETHOD then
    local oldIndex; oldIndex = hookmetamethod(game,"__index",newcclosure(function(self,idx)
        if not checkcaller() then
