-- [12] RESOLVER
-- ═══════════════════════════════════════════════════════════
local ResolverData = {}

local function resolverGet(p, method)
    local char = p.Character; if not char then return Vector3.zero end
    local hrp  = getRoot(char); if not hrp then return Vector3.zero end
    local uid  = p.UserId
    if not ResolverData[uid] then
        ResolverData[uid] = {
            positions={}, timestamps={}, velocities={}, accelerations={},
            lastvelocity=Vector3.zero, lastacceleration=Vector3.zero,
            smoothedvelocity=Vector3.zero, lastupdate=0,
        }
    end
    local d = ResolverData[uid]; local now = tick()
    if now - d.lastupdate < 0.05 then return d.smoothedvelocity end
    d.lastupdate = now
    table.insert(d.positions, hrp.Position); table.insert(d.timestamps, now)
    local samples = Flags.ResolverSamples or 5
    while #d.positions > samples do table.remove(d.positions,1); table.remove(d.timestamps,1) end
    if #d.positions >= 2 then
        local dt = d.timestamps[#d.timestamps] - d.timestamps[#d.timestamps-1]
        if dt > 0 then
            local vel = (d.positions[#d.positions]-d.positions[#d.positions-1])/dt
            table.insert(d.velocities, vel)
            while #d.velocities > samples do table.remove(d.velocities,1) end
            if d.lastvelocity then
                local acc = (vel-d.lastvelocity)/dt
                table.insert(d.accelerations, acc)
                while #d.accelerations > samples do table.remove(d.accelerations,1) end
                d.lastacceleration = acc
            end
            d.lastvelocity = vel
        end
    end
    local smooth = Flags.ResolverSmooth or 0.5
    local v3 = Vector3.zero
    if #d.velocities >= 2 then
        local sum, wsum = Vector3.zero, 0
        for i = 1, #d.velocities do
            local w = i / #d.velocities; sum = sum + d.velocities[i]*w; wsum = wsum + w
        end
        local interp = wsum > 0 and sum/wsum or d.lastvelocity
        if method == "Interpolation" then
            v3 = interp
        elseif method == "Extrapolation" then
            v3 = d.velocities[#d.velocities] + d.lastacceleration*0.1
        else
            local extrap = d.velocities[#d.velocities] + d.lastacceleration*0.1
            v3 = interp:Lerp(extrap, smooth)
        end
    else
        v3 = d.lastvelocity
    end
    if v3.Magnitude > 100 then v3 = v3.Unit*100 end
    d.smoothedvelocity = d.smoothedvelocity:Lerp(v3, 1-smooth)
    return d.smoothedvelocity
end

