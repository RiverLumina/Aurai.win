local function dh_isKnocked(p)
    if not p.Character then return false end
    if p.Character:GetAttribute("Knocked") then return true end
    local be = p.Character:FindFirstChild("BodyEffects")
    if be then
        for _, n in ipairs({"K.O","KO","Knocked"}) do
            local v = be:FindFirstChild(n)
            if v and v.Value then return true end
        end
    end
    local h = getHum(p.Character)
    return h and h:GetState()==Enum.HumanoidStateType.Physics or false
end

local function dh_isDead(p)
    if not p.Character then return true end
    if p.Character:GetAttribute("Dead") then return true end
    local h = getHum(p.Character)
    return not h or h.Health <= 0
end

local function dh_getArmor(p)
    if not p.Character then return 0 end
    for k, v in pairs(p.Character:GetAttributes()) do
        if string.lower(k):find("armor") then return v end
    end
    local be = p.Character:FindFirstChild("BodyEffects")
    if be then
        local a = be:FindFirstChild("Armor")
        if a and a:IsA("NumberValue") then return a.Value end
    end
    return 0
end

