-- ─── KEYBIND INPUT ────────────────────────────────────────
-- hold E (or configured key) to aim
local AimKeyEnum = Enum.KeyCode.E   -- default

local function strToKeyEnum(s)
    if s == "RMB" then return Enum.UserInputType.MouseButton2 end
    if s == "LMB" then return Enum.UserInputType.MouseButton1 end
    local ok, v = pcall(function() return Enum.KeyCode[s] end)
    return ok and v or Enum.KeyCode.E
end

AimKeyEnum = strToKeyEnum(Flags.AimKey)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or UserInputService:GetFocusedTextBox() then return end
    local matchKey = (input.KeyCode == AimKeyEnum or input.UserInputType == AimKeyEnum)
    if matchKey and Flags.AimEnable then
        if Flags.AimOnePressMode then
            if Aiming then resetAimbot()
            else Aiming = true end
        else
            Aiming = true
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, gpe)
    if gpe then return end
    local matchKey = (input.KeyCode == AimKeyEnum or input.UserInputType == AimKeyEnum)
    if matchKey and not Flags.AimOnePressMode then
        resetAimbot()
    end
end)

-- ─── SILENT AIM HOOK ──────────────────────────────────────
if HAS_HOOKMETHOD then
    local oldIndex; oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, idx)
        if not checkcaller() and Flags.AimEnable and Flags.AimMode=="Silent"
            and Aiming and isReady(Target) then
            local _, _, vpPos, worldPos, aimPart = isReady(Target)
            local chance = math.random(1,100) <= Flags.SilentChance
            if chance and self == Mouse then
                if idx=="Hit" or idx=="hit" then
                    return CFrame.new(worldPos)
                elseif idx=="Target" or idx=="target" then
                    return aimPart
                elseif idx=="X" or idx=="x" then
                    return vpPos and vpPos.X
                elseif idx=="Y" or idx=="y" then
                    return vpPos and vpPos.Y
                end
            end
        end
        return oldIndex(self, idx)
    end))

    local oldNameCall; oldNameCall = hookmetamethod(game, "__namecall", newcclosure(function(...)
        local method = getnamecallmethod()
        local args   = {...}
        local self   = args[1]
        if not checkcaller() and Flags.AimEnable and Flags.AimMode=="Silent"
            and Aiming and isReady(Target)
            and math.random(1,100) <= Flags.SilentChance then
            local _, _, vpPos, worldPos, aimPart = isReady(Target)
            if self == UserInputService and method == "GetMouseLocation" then
                return Vector2.new(vpPos.X, vpPos.Y)
            elseif self == workspace and (method=="Raycast" or method=="raycast")
                and typeof(args[2])=="Vector3" and typeof(args[3])=="Vector3" then
                local dir = (worldPos - args[2]).Unit * (worldPos - args[2]).Magnitude
                args[3] = dir
                return oldNameCall(table.unpack(args))
            end
        end
        return oldNameCall(...)
    end))
    cOk("Silent aim hooks installed")
end

