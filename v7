-- ═══════════════════════════════════════════════════════════
local function mkLine(x1,y1,x2,y2,col,th)
    if not HAS_DRAWING then return nil end
    local ok,l = pcall(function()
        local l = Drawing.new("Line")
        l.From=Vector2.new(x1,y1); l.To=Vector2.new(x2,y2)
        l.Color=col; l.Thickness=th or 1; l.Visible=true
        return l
    end)
    return ok and l or nil
end

local function mkTxt(txt,x,y,col,sz,center)
    if not HAS_DRAWING then return nil end
    local ok,t = pcall(function()
        local t = Drawing.new("Text")
        t.Text=txt; t.Position=Vector2.new(x,y)
        t.Color=col or Color3.new(1,1,1)
        t.Size=sz or 13; t.Font=DRAW_FONT
        t.Outline=true; t.Center=center or false
        t.Visible=true
        return t
    end)
    return ok and t or nil
end

local function mkCircle(cx,cy,r,col,th,filled,sides)
    if not HAS_DRAWING then return nil end
    local ok,c = pcall(function()
        local c = Drawing.new("Circle")
        c.Position=Vector2.new(cx,cy); c.Radius=r
        c.Color=col; c.Filled=filled or false
        c.Thickness=th or 1; c.NumSides=sides or 64
        c.Visible=true
        return c
    end)
    return ok and c or nil
end

local function mkSquare(x,y,w,h,col,th,filled)
    if not HAS_DRAWING then return nil end
    local ok,s = pcall(function()
        local s = Drawing.new("Square")
        s.Position=Vector2.new(x,y); s.Size=Vector2.new(w,h)
        s.Color=col; s.Thickness=th or 1
        s.Filled=filled or false; s.Visible=true
        return s
    end)
    return ok and s or nil
end

local function w2s(pos)
    local v, inV = Camera:WorldToViewportPoint(pos)
    return Vector2.new(v.X,v.Y), inV, v.Z
end

