-- [14] HIT MARKER
-- ═══════════════════════════════════════════════════════════
local hitMarkers = {}

local function spawnHitMark(lethal)
    if not Flags.HitMark or not HAS_DRAWING then return end
    local cx = Camera.ViewportSize.X/2
    local cy = Camera.ViewportSize.Y/2
    local col = lethal and Color3.fromRGB(255,50,50) or fc("ColHitMark")
    local sz  = lethal and 10 or 7
    local lines = {}
    for _, o in ipairs({{-sz,-sz,sz,sz},{sz,-sz,-sz,sz}}) do
        local l = mkLine(cx+o[1],cy+o[2],cx+o[3],cy+o[4],col,1.5)
        if l then table.insert(lines,l) end
    end
    if Flags.HitSound then
        pcall(function()
            local s = Instance.new("Sound")
            s.SoundId="rbxassetid://264486467"; s.Volume=0.4
            s.Parent=workspace; s:Play()
            task.delay(0.3, function() s:Destroy() end)
        end)
    end
    table.insert(hitMarkers, {lines=lines, t=tick()})
end

