-- [19] AIMBOT LOOP — ported from Open Aimbot's main loop
-- ═══════════════════════════════════════════════════════════
RunService.Heartbeat:Connect(function()
    -- SpinBot
    if Flags.SpinBot then
        local char = LP.Character
        local hrp  = char and getRoot(char)
        if hrp then
            hrp.CFrame = hrp.CFrame * CFrame.fromEulerAnglesXYZ(0, math.rad(Flags.SpinSpeed), 0)
        end
    end

    if not Flags.AimEnable or not Aiming then
        if AimTween then AimTween:Cancel(); AimTween=nil end
        UserInputService.MouseDeltaSensitivity = SavedMouseSensitivity
        return
    end

    -- Find closest valid target within FOV (Open Aimbot pattern)
    if not isReady(Target) then
        local closest = math.huge
        Target = nil
        local mousePos = UserInputService:GetMouseLocation()
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LP then continue end
            local char = p.Character; if not char then continue end
            local ok, _, vpPos = isReady(char)
            if ok and vpPos then
                local dx = vpPos.X - mousePos.X
                local dy = vpPos.Y - mousePos.Y
                local mag = math.sqrt(dx*dx+dy*dy)
                if mag < closest then
                    closest = mag
                    Target  = char
                end
            end
        end
    end

    local ok, _, vpPos, worldPos = isReady(Target)
    if not ok then
        resetAimbot(false)
        return
    end

    local mode = Flags.AimMode

    if mode == "Camera" then
        UserInputService.MouseDeltaSensitivity = 0
        if Flags.AimSmooth then
            if AimTween then AimTween:Cancel() end
            AimTween = TweenService:Create(
                Camera,
                TweenInfo.new(
                    math.clamp(Flags.AimSmoothVal,1,99)/100,
                    Enum.EasingStyle.Sine,
                    Enum.EasingDirection.Out
                ),
                { CFrame = CFrame.new(Camera.CFrame.Position, worldPos) }
            )
            AimTween:Play()
        else
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, worldPos)
        end

    elseif mode == "Mouse" and HAS_MOUSEMOVE then
        if AimTween then AimTween:Cancel(); AimTween=nil end
        UserInputService.MouseDeltaSensitivity = SavedMouseSensitivity
        local mousePos = UserInputService:GetMouseLocation()
        local sens = Flags.AimSmooth and math.clamp(Flags.AimSmoothVal,1,99)/10 or 1
        mousemoverel(
            (vpPos.X - mousePos.X) / sens,
            (vpPos.Y - mousePos.Y) / sens
        )

    elseif mode == "Silent" and HAS_HOOKMETHOD then
        -- hooks handle everything, just keep target locked
        UserInputService.MouseDeltaSensitivity = SavedMouseSensitivity
    end
end)

