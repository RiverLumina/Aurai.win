local function getRoot(char)
    return char and (
        char:FindFirstChild("HumanoidRootPart") or
        char:FindFirstChild("Torso") or
        char:FindFirstChild("UpperTorso") or
        char:FindFirstChildOfClass("BasePart")
    )
end

local function getHum(char)
    return char and char:FindFirstChildWhichIsA("Humanoid")
end

local function getAimPart(char, partName)
    if not char then return nil end
    local name = partName or Flags.AimPart
    -- try exact name first
    local p = char:FindFirstChild(name)
    if p and p:IsA("BasePart") then return p end
    -- fallbacks
    local fallbacks = {"Head","HumanoidRootPart","UpperTorso","Torso"}
    for _, fn in ipairs(fallbacks) do
        local fp = char:FindFirstChild(fn)
        if fp and fp:IsA("BasePart") then return fp end
    end
    return char:FindFirstChildOfClass("BasePart")
end

local function isEnemy(p)
    if p == LP then return false end
    if not Flags.AimTeamCheck then return true end
    local ok, result = pcall(function()
        return p.TeamColor ~= LP.TeamColor
    end)
    return ok and result or true
end

-- ═══════════════════════════════════════════════════════════
-- [9] TARGET VALIDATION (ported from Open Aimbot IsReady)
-- ═══════════════════════════════════════════════════════════
local function isReady(char)
    if not char then return false end
    local p = Players:GetPlayerFromCharacter(char)
    if not p or p == LP then return false end

    local hum = getHum(char)
    if not hum then return false end

    local aimPart = getAimPart(char)
    if not aimPart then return false end

    local myChar = LP.Character
    if not myChar then return false end
    local myRoot = getRoot(myChar)
    if not myRoot then return false end

    -- Alive check
    if Flags.AimAliveCheck and hum.Health <= 0 then return false end

    -- God check (insane HP or forcefield)
    if hum.Health >= 10^36 or myChar:FindFirstChildOfClass("ForceField") then return false end

    -- Team check
    if Flags.AimTeamCheck then
        local ok, same = pcall(function() return p.TeamColor == LP.TeamColor end)
        if ok and same then return false end
    end

    -- Wall check
    if Flags.AimWallCheck then
        local dir = (aimPart.Position - myRoot.Position)
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = {myChar}
        local result = workspace:Raycast(myRoot.Position, dir, rp)
        if not result or not result.Instance then return false end
        if not result.Instance:FindFirstAncestor(p.Name) then return false end
    end

    -- FOV check
    local vpPos, inV = Camera:WorldToViewportPoint(aimPart.Position)
    if not inV then return false end

    if Flags.AimFOVCheck then
        local mousePos = UserInputService:GetMouseLocation()
        local dx = vpPos.X - mousePos.X
        local dy = vpPos.Y - mousePos.Y
        if math.sqrt(dx*dx+dy*dy) > Flags.AimFOV then return false end
    end

    return true, char, Vector2.new(vpPos.X, vpPos.Y), aimPart.Position, aimPart
end

