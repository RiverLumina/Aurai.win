-- ═══════════════════════════════════════════════════════════
local ConBuf  = {}
local ConTab  = nil
local ConLbls = {}

local function cPush(kind, msg)
    local pre = kind=="ok" and "✓ " or kind=="fail" and "✗ " or kind=="warn" and "⚠ " or "  "
    local line = pre..tostring(msg)
    table.insert(ConBuf, {text=line, kind=kind})
    if #ConBuf > 80 then table.remove(ConBuf,1) end
    if ConTab then
        local tag = kind=="ok" and "[OK]  " or kind=="fail" and "[ERR] " or kind=="warn" and "[WRN] " or "[INF] "
        local lbl = ConTab:CreateLabel({ text=tag..line })
        table.insert(ConLbls, lbl)
        if #ConLbls > 80 then
            pcall(function() ConLbls[1]:Remove() end)
            table.remove(ConLbls,1)
        end
    end
    if kind=="fail" then warn("[Aurai] "..line) else print("[Aurai] "..line) end
end

local function cInfo(m) cPush("info",m) end
local function cOk(m)   cPush("ok",  m) end
local function cWarn(m) cPush("warn",m) end
local function cFail(m) cPush("fail",m) end

local function flushConsole()
    if not ConTab then return end
    ConTab:CreateSection({ name="Boot Log" })
    for _, l in ipairs(ConBuf) do
        local tag = l.kind=="ok" and "[OK]  " or l.kind=="fail" and "[ERR] " or l.kind=="warn" and "[WRN] " or "[INF] "
        table.insert(ConLbls, ConTab:CreateLabel({ text=tag..l.text }))
    end
    ConTab:CreateSection({ name="Live Log" })
end

