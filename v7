local glowStore = {}

local function clearGlow(p)
    local g = glowStore[p]
    if g then pcall(function() g:Destroy() end) end
    glowStore[p] = nil
end

local function applyGlow(p, col)
    local char = p.Character; if not char then return end
    if glowStore[p] then
        if not glowStore[p].Parent then
            pcall(function() glowStore[p]:Destroy() end)
            glowStore[p] = nil
        else
            glowStore[p].Color3 = col
            glowStore[p].SurfaceColor3 = col
            return
        end
    end
    local g = Instance.new("SelectionBox")
    g.Adornee = char; g.Color3 = col
    g.LineThickness = 0.07; g.SurfaceTransparency = 1
    g.SurfaceColor3 = col; g.Parent = workspace
    glowStore[p] = g
end

-- ═══════════════════════════════════════════════════════════
-- [12] CHAMS (SelectionBox per limb)
-- ═══════════════════════════════════════════════════════════
local chamsStore = {}

local CHAM_PARTS = {
    "Head","UpperTorso","LowerTorso","Torso",
    "LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm",
    "LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg",
    "Left Arm","Right Arm","Left Leg","Right Leg",
}

local function clearChams(p)
    local d = chamsStore[p]; if not d then return end
    for _, b in ipairs(d.vis)  do pcall(function() b:Destroy() end) end
    for _, b in ipairs(d.wall) do pcall(function() b:Destroy() end) end
    chamsStore[p] = nil
end

local function applyChams(p)
    if chamsStore[p] then return end
    local char = p.Character; if not char then return end
    local vis = {}; local wall = {}
    for _, pn in ipairs(CHAM_PARTS) do
        local part = char:FindFirstChild(pn); if not part then continue end
        local bv = Instance.new("SelectionBox")
        bv.Adornee=part; bv.Color3=fc("ColChamsVis")
        bv.LineThickness=0.04; bv.SurfaceTransparency=0.5
        bv.SurfaceColor3=fc("ColChamsVis"); bv.Parent=workspace
        table.insert(vis, bv)
        local bw = Instance.new("SelectionBox")
        bw.Adornee=part; bw.Color3=fc("ColChamsWall")
        bw.LineThickness=0.02; bw.SurfaceTransparency=0.75
        bw.SurfaceColor3=fc("ColChamsWall"); bw.Parent=workspace
        table.insert(wall, bw)
    end
    chamsStore[p] = {vis=vis, wall=wall}
end

local function tickChams()
    for p, d in pairs(chamsStore) do
        local char = p.Character
        local hum  = char and getHum(char)
        local alive = hum and hum.Health > 0
        for _, b in ipairs(d.vis)  do b.Visible = alive and Flags.ChamsEnable and Flags.ChamsVisible end
        for _, b in ipairs(d.wall) do b.Visible = alive and Flags.ChamsEnable and Flags.ChamsWall end
    end
end

