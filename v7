-- FOV circle (single persistent object)
local fovCircle = nil

local function ensureFovCircle()
    if not HAS_DRAWING then return end
    if not fovCircle then
        fovCircle = mkCircle(0,0,Flags.AimFOV,fc("ColFOV"),Flags.FOVThickness,Flags.FOVFilled,64)
    end
end

local function updateFovCircle()
    if not Flags.FOVShow or not Flags.AimEnable then
        if fovCircle then
            pcall(function() fovCircle.Visible=false end)
        end
        return
    end
    ensureFovCircle()
    if fovCircle then
        local ml = UserInputService:GetMouseLocation()
        fovCircle.Position  = Vector2.new(ml.X, ml.Y)
        fovCircle.Radius    = Flags.AimFOV
        fovCircle.Color     = fc("ColFOV")
        fovCircle.Thickness = Flags.FOVThickness
        fovCircle.Filled    = Flags.FOVFilled
        fovCircle.Visible   = true
    end
end

