local origAmbient, origOutdoor, origFogEnd

local function applyFullBright(on)
    local L = game:GetService("Lighting")
    if on then
        origAmbient = origAmbient or L.Ambient
        origOutdoor = origOutdoor or L.OutdoorAmbient
        L.Ambient=Color3.new(1,1,1); L.OutdoorAmbient=Color3.new(1,1,1); L.Brightness=2
    else
        if origAmbient then L.Ambient=origAmbient end
        if origOutdoor then L.OutdoorAmbient=origOutdoor end
        L.Brightness=1
    end
end

local function applyNoFog(on)
    local L = game:GetService("Lighting")
    if on then origFogEnd=origFogEnd or L.FogEnd; L.FogEnd=100000
    else if origFogEnd then L.FogEnd=origFogEnd end end
end

