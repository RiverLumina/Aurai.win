local radarGui, radarFrame, radarDots = nil,nil,{}

local function buildRadar()
    if radarGui then return end
    radarGui = Instance.new("ScreenGui")
    radarGui.Name="AuraiRadar"; radarGui.ResetOnSpawn=false
    radarGui.IgnoreGuiInset=true; radarGui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    radarFrame = Instance.new("Frame")
    radarFrame.Size=UDim2.new(0,160,0,160)
    radarFrame.Position=UDim2.new(1,-180,1,-180)
    radarFrame.BackgroundColor3=Color3.fromRGB(8,8,14)
    radarFrame.BackgroundTransparency=0.3
    radarFrame.BorderSizePixel=0; radarFrame.Parent=radarGui
    Instance.new("UICorner",radarFrame).CornerRadius=UDim.new(0,8)
    local border=Instance.new("UIStroke")
    border.Color=fc("ColRadar"); border.Thickness=1.5; border.Parent=radarFrame
    for _,v in ipairs({{0,0.5,1,0.5},{0.5,0,0.5,1}}) do
        local l=Instance.new("Frame")
        l.BackgroundColor3=Color3.new(1,1,1); l.BackgroundTransparency=0.88
        l.BorderSizePixel=0
        l.Position=UDim2.new(v[1],0,v[2],0)
        l.Size=UDim2.new(v[3]-v[1],0,v[4]-v[2],1)
