    sd.Parent=radarFrame
    Instance.new("UICorner",sd).CornerRadius=UDim.new(1,0)
    radarGui.Parent=LP.PlayerGui
end

local function destroyRadar()
    if radarGui then radarGui:Destroy(); radarGui=nil; radarFrame=nil; radarDots={} end
end

