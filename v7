-- [18] MAIN RENDER LOOP — ported from Open Aimbot pattern
-- ═══════════════════════════════════════════════════════════
RunService.RenderStepped:Connect(function()
    -- ── Glow / Chams management ───────────────────────────
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if Flags.ESPGlow then
            local charTarget = Target and Players:GetPlayerFromCharacter(Target)
            local col = isEnemy(p) and fc("ColEnemy") or fc("ColTeam")
            if p == charTarget then col = fc("ColTarget") end
            applyGlow(p, col)
        else clearGlow(p) end

        if Flags.ChamsEnable then applyChams(p)
        else clearChams(p) end
    end
    tickChams()

    -- ── HitMarker fade ────────────────────────────────────
    local now = tick()
    for i = #hitMarkers,1,-1 do
        local hm = hitMarkers[i]; local age = now-hm.t
        if age > 0.22 then
            for _,l in ipairs(hm.lines) do pcall(function() l:Remove() end) end
            table.remove(hitMarkers,i)
        else
            local a = 1-age/0.22
            for _,l in ipairs(hm.lines) do l.Transparency=1-a end
        end
    end

    -- ── FOV Circle ────────────────────────────────────────
    updateFovCircle()

    -- ── ESP Drawing ───────────────────────────────────────
    if not Flags.ESPEnable or not HAS_DRAWING then
        clearAllEsp(); return
    end

    -- Use Open Aimbot's box sizing formula: 2350/Z for width
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        clearEspPlayer(p)

        local char = p.Character; if not char then continue end
        local hum  = getHum(char)
        if not hum or hum.Health <= 0 then continue end
        local hrp  = getRoot(char); if not hrp then continue end
        local head = char:FindFirstChild("Head") or hrp

        local hrpVP, inV, depth = Camera:WorldToViewportPoint(hrp.Position)
        if not inV or depth < 0 then continue end

        local headVP    = Camera:WorldToViewportPoint(head.Position)
        local topVP     = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
        local bottomVP  = Camera:WorldToViewportPoint(hrp.Position  - Vector3.new(0,3,0))

        -- Open Aimbot style: width=2350/Z
        local boxW = 2350 / hrpVP.Z
        local boxH = math.abs(topVP.Y - bottomVP.Y)
        local boxX = hrpVP.X - boxW/2
        local boxY = hrpVP.Y - boxH/2

        -- colour
        local charTarget = Target and Players:GetPlayerFromCharacter(Target)
        local isT = p == charTarget
        local col
        if Flags.ESPTeamColour then
            col = pcall(function() return p.TeamColor.Color end) and p.TeamColor.Color or fc("ColEnemy")
        else
            col = isEnemy(p) and fc("ColEnemy") or fc("ColTeam")
            if isT then col = fc("ColTarget") end
        end

        local d = {}
        espObjs[p] = d

        -- Box (full square, Open Aimbot style)
        if Flags.ESPBox then
            d.box = mkSquare(boxX, boxY, boxW, boxH, col, Flags.ESPThickness, false)
        end

        -- Name
        if Flags.ESPName then
            local lbl = isT and ("🎯 "..p.Name.." 🎯") or ("@"..p.Name)
            d.name = mkTxt(lbl, hrpVP.X, boxY+boxH-20, col, 13, true)
        end

        -- Health
        if Flags.ESPHealth then
            d.health = mkTxt(
                string.format("[%.0f%%]", hum.Health/hum.MaxHealth*100),
                hrpVP.X, headVP.Y-16, col, 12, true
            )
        end

        -- Distance
        if Flags.ESPDistance then
            local dist = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude)
            d.dist = mkTxt("["..dist.."m]", hrpVP.X, hrpVP.Y, col, 11, true)
        end

        -- Tracer
        if Flags.ESPTracer then
            d.tracer = mkLine(
                Camera.ViewportSize.X/2, Camera.ViewportSize.Y,
                hrpVP.X, boxY,
                fc("ColTracer"), Flags.ESPThickness
            )
        end
    end

    -- ── Radar ─────────────────────────────────────────────
    if not Flags.RadarEnable then
        if radarGui then destroyRadar() end
    else
        if not radarGui then buildRadar() end
        local myHRP = LP.Character and getRoot(LP.Character)
        if myHRP then
            local myCF  = myHRP.CFrame
            local myYaw = math.atan(myCF.LookVector.X, -myCF.LookVector.Z)
            for p, dot in pairs(radarDots) do
                if not Players:FindFirstChild(p.Name) then dot:Destroy(); radarDots[p]=nil end
            end
            for _, p in ipairs(Players:GetPlayers()) do
                if p==LP then continue end
                local char=p.Character; if not char then continue end
                local hrp=getRoot(char); if not hrp then continue end
                local hum=getHum(char)
                if not hum or hum.Health<=0 then
                    if radarDots[p] then radarDots[p]:Destroy(); radarDots[p]=nil end
                    continue
                end
                local dotCol=isEnemy(p) and fc("ColRadar") or Color3.fromRGB(80,220,80)
                if not radarDots[p] then
                    local dot=Instance.new("Frame")
                    dot.Size=UDim2.new(0,7,0,7); dot.AnchorPoint=Vector2.new(0.5,0.5)
                    dot.BackgroundColor3=dotCol; dot.BorderSizePixel=0
                    dot.Parent=radarFrame
                    Instance.new("UICorner",dot).CornerRadius=UDim.new(1,0)
                    radarDots[p]=dot
                end
                radarDots[p].BackgroundColor3=dotCol
                local delta=hrp.Position-myHRP.Position
                local cos=math.cos(-myYaw); local sin=math.sin(-myYaw)
                local rx=delta.X*cos-delta.Z*sin
                local rz=delta.X*sin+delta.Z*cos
                radarDots[p].Position=UDim2.new(
                    math.clamp(0.5+rx*0.08,0.05,0.95),0,
                    math.clamp(0.5+rz*0.08,0.05,0.95),0
                )
            end
        end
    end
end)

